// ========== 侧边栏缩窄/还原 ==========
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const toggleBtn = document.getElementById('sidebarToggle');
    sidebar.classList.toggle('collapsed');
    if (sidebar.classList.contains('collapsed')) {
        toggleBtn.innerHTML = '<span>▶</span><span>展开侧边栏</span>';
        localStorage.setItem('sidebarCollapsed', 'true');
    } else {
        toggleBtn.innerHTML = '<span>◀</span><span>收起侧边栏</span>';
        localStorage.setItem('sidebarCollapsed', 'false');
    }
}

function loadSidebarState() {
    const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
    const sidebar = document.getElementById('sidebar');
    const toggleBtn = document.getElementById('sidebarToggle');
    if (isCollapsed) {
        sidebar.classList.add('collapsed');
        toggleBtn.innerHTML = '<span>▶</span><span>展开侧边栏</span>';
    }
}

// ========== 菜单交互 ==========
function toggleSubmenu(el) {
    if (document.getElementById('sidebar').classList.contains('collapsed')) return;
    el.classList.toggle('expanded');
    if (el.nextElementSibling) {
        el.nextElementSibling.classList.toggle('active');
    }
}



function switchPage(pageId) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const targetPage = document.getElementById(pageId);
    if (targetPage) targetPage.classList.add('active');

    const titles = {
        dashboard:'📊 仪表盘', pods:'📦 Pods', pods_manager:'📦 Pod 管理(高级)', nodes:'🖥️   节点',
        deployments:'🚀 Deployments', services:'🔌 Services', configmaps:'📋 ConfigMaps',
        namespaces:'📁 命名空间', events:'📅 事件', scheduler:'🚀 容器调度',
        harborImages:'🐳 Harbor 镜像', harborProjects:'📁 Harbor 项目', grafana:'📈 Grafana 监控',
        jenkins:'⚙️ Jenkins CICD', pytestweb:'🧪 PytestWEB', autotest:'🧪 自动化测试',
        cephflask:'💾 Ceph 管理', dify: '🤖 Dify AI', config:'⚙️ 组件配置', scheduler_advanced:'🚀 容器调度（增强版）',
        ceph_storage:'💾 Ceph 网盘', model_plaza: '🏛️ 模型广场',openwebui: '💬 Open WebUI',money:'💰 大盘星图', showdoc: '📚 ShowDoc 文档',
        nexus: '📦 Nexus 仓库',gitlab_manager:'📊 GitLab 管理',gitlab:'🦊 极狐 GitLab'
    };
    document.getElementById('pageTitle').innerText = titles[pageId] || pageId;

    // ✅ 只保留必要的加载器，移除 gitlab_manager
    const loaders = {
        dashboard: fetchDashboardData,
        pods: fetchPodsList,
        nodes: fetchNodesList,
        deployments: fetchDeploymentsList,
        services: fetchServicesList,
        configmaps: fetchConfigMapsList,
        namespaces: fetchNamespacesList,
        events: fetchEventsList,
        scheduler: loadSchedulerPage,
        harborImages: loadHarborProjectsPage,
        harborProjects: loadHarborProjectsPage,
        config: renderConfigTable,
        autotest: autoLoginAutotest
    };

    if (loaders[pageId]) {
        loaders[pageId]();
    }

    if (pageId === 'grafana') {
        const c = document.getElementById('grafana');
        if (!c.querySelector('iframe')) {
            c.innerHTML = '<iframe src="/grafana/?theme=light" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe>';
        }
    }
    if (pageId === 'cephflask') {
        document.getElementById('cephflaskIframe').src = getConfig('Ceph Flask');
    }

if (pageId === 'gitlab_manager') {
    var frame = document.getElementById('gitlabManagerFrame');
    var loading = document.getElementById('gitlabLoading');
    const targetSrc = 'http://192.168.138.139:8081/gitlab_manager.html';
    
    if (frame) {
        // 用自定义属性判断是否已加载，而不是判断src
        if (!frame.dataset.loaded) {
            // 显示加载提示
            if (loading) loading.style.display = 'flex';
            frame.style.display = 'none';
            
            setTimeout(function() {
                frame.src = targetSrc;
            }, 300);
            
            frame.onload = function() {
                if (loading) loading.style.display = 'none';
                frame.style.display = 'block';
                frame.dataset.loaded = 'true';
                frame.onload = null;
            };
            
            // 8秒超时兜底
            setTimeout(function() {
                if (loading && loading.style.display !== 'none') {
                    loading.style.display = 'none';
                    frame.style.display = 'block';
                }
            }, 8000);
        } else {
            // 已经加载过，直接显示
            if (loading) loading.style.display = 'none';
            frame.style.display = 'block';
        }
    }
}
    if (pageId === 'gitlab') {
        const c = document.getElementById('gitlab');
        if (c && !c.querySelector('iframe')) {
            c.innerHTML = '<iframe src="/gitlab/" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe>';
        }
    }


}



async function checkAPIServerHealth() {
    const statusSpan = document.getElementById('apiServerStatus');
    const badgeSpan = document.getElementById('apiServerStatusBadge');
    const latencySpan = document.getElementById('apiServerLatency');
    const timeSpan = document.getElementById('apiServerTime');
    const detailSpan = document.getElementById('apiServerDetail');

    const startTime = Date.now();
    try {
        const response = await fetch('/api/health');
        const endTime = Date.now();
        const latency = endTime - startTime;
        const now = new Date().toLocaleTimeString();

        if (response.ok) {
            statusSpan.innerHTML = '✅ 正常';
            statusSpan.style.color = '#2e7d32';
            badgeSpan.innerHTML = '✅ 正常';
            badgeSpan.className = 'badge';
            badgeSpan.style.background = '#e8f5e9';
            badgeSpan.style.color = '#2e7d32';
            latencySpan.innerHTML = `${latency}ms`;
            timeSpan.innerHTML = now;
            detailSpan.innerHTML = `API Server 响应正常，状态码: ${response.status}`;
        } else {
            statusSpan.innerHTML = '❌ 异常';
            statusSpan.style.color = '#c62828';
            badgeSpan.innerHTML = '❌ 异常';
            badgeSpan.className = 'badge';
            badgeSpan.style.background = '#ffebee';
            badgeSpan.style.color = '#c62828';
            latencySpan.innerHTML = `${latency}ms`;
            timeSpan.innerHTML = now;
            detailSpan.innerHTML = `API Server 返回异常状态码: ${response.status}`;
        }
    } catch(e) {
        const endTime = Date.now();
        const latency = endTime - startTime;
        const now = new Date().toLocaleTimeString();

        statusSpan.innerHTML = '❌ 不可用';
        statusSpan.style.color = '#c62828';
        badgeSpan.innerHTML = '❌ 不可用';
        badgeSpan.className = 'badge';
        badgeSpan.style.background = '#ffebee';
        badgeSpan.style.color = '#c62828';
        latencySpan.innerHTML = `${latency}ms`;
        timeSpan.innerHTML = now;
        detailSpan.innerHTML = `连接失败: ${e.message}`;
    }
}



function logout() {
    if (confirm('确定要退出登录吗？')) {
        // 清除本地用户信息
        currentUser = null;
        // 清除存储的 token（如果有）
        localStorage.removeItem('token');
        sessionStorage.clear();
        // 跳转到登录页（如果没有登录页，跳回首页并刷新）
        window.location.href = '/';
    }
}


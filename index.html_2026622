<!-- 新建 Harbor 项目模态框 -->
<div id="createProjectModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 500px;">
        <div class="modal-header">
            <span>➕ 新建 Harbor 项目</span>
            <span class="modal-close" onclick="closeCreateProjectModal()">&times;</span>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>项目名称 <span style="color: red;">*</span></label>
                <input type="text" id="newProjectName" class="form-control" placeholder="例如: myproject">
                <small style="color:#909399;">只能包含小写字母、数字、下划线、连字符</small>
            </div>
            <div class="form-group">
                <label>访问级别</label>
                <select id="newProjectPublic" class="form-control">
                    <option value="false">🔒 私有</option>
                    <option value="true">🌐 公开</option>
                </select>
            </div>
            <div class="form-group">
                <label>存储容量限制 (GB)</label>
                <input type="number" id="newProjectStorage" class="form-control" placeholder="不限制" value="">
                <small style="color:#909399;">留空表示不限制</small>
            </div>
        </div>
        <div class="modal-footer" style="padding: 16px 20px; border-top: 1px solid #e4e7ed; display: flex; gap: 8px; justify-content: flex-end;">
            <button class="btn btn-outline" onclick="closeCreateProjectModal()">取消</button>
            <button class="btn btn-primary" onclick="createHarborProject()">创建项目</button>
        </div>
    </div>
</div>




<!-- 上传镜像模态框 -->
<div id="uploadImageModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <span>📤 上传镜像到 Harbor</span>
            <span class="modal-close" onclick="closeUploadImageModal()">&times;</span>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>选择项目</label>
                <select id="uploadProject" class="form-control"></select>
            </div>
            <div class="form-group">
                <label>镜像名称</label>
                <input type="text" id="uploadImageName" class="form-control" placeholder="例如: myapp">
                <small style="color:#909399;">只能包含小写字母、数字、下划线、连字符</small>
            </div>
            <div class="form-group">
                <label>镜像标签</label>
                <input type="text" id="uploadImageTag" class="form-control" placeholder="例如: latest">
            </div>
            <div class="form-group">
                <label>选择镜像文件 (.tar)</label>
                <input type="file" id="uploadTarFile" accept=".tar" class="form-control">
                <small style="color:#909399;">支持 docker save 导出的 tar 包</small>
            </div>
            <div id="uploadProgress" style="display: none;">
                <div class="progress-bar"><div class="progress-fill" id="uploadProgressFill" style="width:0%"></div></div>
                <div id="uploadStatus" style="margin-top: 8px; font-size: 12px; color: #666;"></div>
            </div>
        </div>
        <div class="modal-footer" style="padding: 16px 20px; border-top: 1px solid #e4e7ed; display: flex; gap: 8px; justify-content: flex-end;">
            <button class="btn btn-outline" onclick="closeUploadImageModal()">取消</button>
            <button class="btn btn-primary" onclick="uploadImage()" id="uploadBtn">开始上传</button>
        </div>
    </div>
</div>





<!-- 上传镜像模态框 -->
<div id="uploadImageModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <span>📤 上传镜像到 Harbor</span>
            <span class="modal-close" onclick="closeUploadImageModal()">&times;</span>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>选择项目</label>
                <select id="uploadProject" class="form-control"></select>
            </div>
            <div class="form-group">
                <label>镜像名称</label>
                <input type="text" id="uploadImageName" class="form-control" placeholder="例如: myapp">
                <small style="color:#909399;">只能包含小写字母、数字、下划线、连字符</small>
            </div>
            <div class="form-group">
                <label>镜像标签</label>
                <input type="text" id="uploadImageTag" class="form-control" placeholder="例如: latest" value="latest">
            </div>
            <div class="form-group">
                <label>选择镜像文件 (.tar)</label>
                <input type="file" id="uploadTarFile" accept=".tar" class="form-control">
                <small style="color:#909399;">支持 docker save 导出的 tar 包</small>
            </div>
            <div id="uploadProgress" style="display: none;">
                <div class="progress-bar"><div class="progress-fill" id="uploadProgressFill"></div></div>
                <div id="uploadStatus" style="margin-top: 8px; font-size: 12px; color: #666;"></div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeUploadImageModal()">取消</button>
            <button class="btn btn-primary" onclick="uploadImage()" id="uploadBtn">开始上传</button>
        </div>
    </div>
</div>








    <!-- 用户信息模态框 -->
    <div id="userModal" class="modal" style="display: none;">
        <div class="modal-content" style="max-width: 500px; background: white; border-radius: 8px;">
            <div class="modal-header" style="padding: 16px 20px; border-bottom: 1px solid #e4e7ed; display: flex; justify-content: space-between; align-items: center;">
                <span>👤 用户信息</span>
                <span class="modal-close" onclick="closeUserModal()" style="cursor: pointer; font-size: 20px;">&times;</span>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <div class="form-group">
                    <label>用户名</label>
                    <input type="text" id="userUsername" class="form-control" readonly disabled>
                </div>
                <div class="form-group">
                    <label>全名</label>
                    <input type="text" id="userFullname" class="form-control" placeholder="请输入全名">
                </div>
                <div class="form-group">
                    <label>用户组</label>
                    <input type="text" id="userGroup" class="form-control" readonly disabled>
                </div>
                <div class="form-group">
                    <label>电子邮件</label>
                    <input type="email" id="userEmail" class="form-control" placeholder="请输入邮箱">
                </div>
                <div class="form-group">
                    <label>角色</label>
                    <input type="text" id="userRole" class="form-control" readonly disabled>
                </div>
            </div>
            <div class="modal-footer" style="padding: 16px 20px; border-top: 1px solid #e4e7ed; display: flex; gap: 8px; justify-content: flex-end;">
                <button class="btn btn-outline" onclick="closeUserModal()">取消</button>
                <button class="btn btn-primary" onclick="saveUserInfo()">保存修改</button>
            </div>
        </div>
    </div>

    <div id="dashboard" class="page active">
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-header"><span>节点总数</span><div class="stat-icon nodes">🖥️</div></div><div class="stat-number" id="statNodes">-</div></div>
            <div class="stat-card"><div class="stat-header"><span>Pod 总数</span><div class="stat-icon pods">📦</div></div><div class="stat-number" id="statPods">-</div></div>
            <div class="stat-card"><div class="stat-header"><span>运行中 Pod</span><div class="stat-icon running">✅</div></div><div class="stat-number" id="statRunning">-</div></div>
            <div class="stat-card"><div class="stat-header"><span>Deployments</span><div class="stat-icon deploy">🚀</div></div><div class="stat-number" id="statDeploy">-</div></div>
        </div>
            <!-- API Server 健康检查卡片 -->
    <div class="content-section" style="padding: 16px 20px;">
        <div class="section-header">
            <h2>🔌 API Server 健康检查</h2>
            <span class="badge" id="apiServerStatusBadge">检查中...</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
            <div>
                <span style="font-size: 14px; color: #666;">状态：</span>
                <strong id="apiServerStatus" style="font-size: 16px;">-</strong>
            </div>
            <div>
                <span style="font-size: 14px; color: #666;">响应时间：</span>
                <strong id="apiServerLatency">-</strong>
            </div>
            <div>
                <span style="font-size: 14px; color: #666;">最后检查：</span>
                <strong id="apiServerTime">-</strong>
            </div>
            <button onclick="checkAPIServerHealth()" style="padding: 4px 12px; background: #4a90e2; color: white; border: none; border-radius: 4px; cursor: pointer;">🔄 刷新</button>
        </div>
        <div id="apiServerDetail" style="margin-top: 12px; font-size: 12px; color: #999; word-break: break-all;"></div>
    </div>

<!-- 集群健康检查面板 -->
<div class="content-section" style="padding: 16px 20px;">
    <div class="section-header">
        <h2>🏥 集群健康检查</h2>
        <button onclick="refreshClusterHealth()" style="padding: 4px 12px; background: #4a90e2; color: white; border: none; border-radius: 4px; cursor: pointer;">🔄 刷新</button>
    </div>

    <!-- 健康检查网格 -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 12px;">

        <!-- etcd 状态 -->
        <div style="padding: 12px; background: #f8f9fa; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <span style="font-size: 18px;">📀</span>
                <span style="font-weight: 600;">etcd 集群</span>
                <span id="etcdStatus" class="health-status checking" style="margin-left: auto;">检查中...</span>
            </div>
            <div id="etcdDetail" style="font-size: 12px; color: #666;"></div>
        </div>

        <!-- OOM 事件 -->
        <div style="padding: 12px; background: #f8f9fa; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <span style="font-size: 18px;">💥</span>
                <span style="font-weight: 600;">OOM 事件</span>
                <span id="oomStatus" class="health-status checking" style="margin-left: auto;">检查中...</span>
            </div>
            <div id="oomDetail" style="font-size: 12px; color: #666;"></div>
        </div>

        <!-- 慢节点 -->
        <div style="padding: 12px; background: #f8f9fa; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <span style="font-size: 18px;">🐌</span>
                <span style="font-weight: 600;">慢节点检测</span>
                <span id="slowNodeStatus" class="health-status checking" style="margin-left: auto;">检查中...</span>
            </div>
            <div id="slowNodeDetail" style="font-size: 12px; color: #666;"></div>
        </div>

        <!-- 网络异常 -->
        <div style="padding: 12px; background: #f8f9fa; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <span style="font-size: 18px;">🌐</span>
                <span style="font-weight: 600;">网络异常</span>
                <span id="networkStatus" class="health-status checking" style="margin-left: auto;">检查中...</span>
            </div>
            <div id="networkDetail" style="font-size: 12px; color: #666;"></div>
        </div>
    </div>
</div>




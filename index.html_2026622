<!DOCTYPE html>
<html>
<head>
    <title>☸️ K8s 集群运维测试开发平台</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f0f2f5; display: flex; min-height: 100vh; }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #151516 0%, #1e1f21 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            overflow-y: auto;
            box-shadow: 2px 0 12px rgba(0,0,0,0.1);
            transition: width 0.3s ease;
            z-index: 100;
        }

        /* 缩窄模式 */
        .sidebar.collapsed { width: 60px; }

        /* 缩窄模式下隐藏所有文字（图标保留） */
        .sidebar.collapsed .sidebar-header h2 span:last-child,
        .sidebar.collapsed .menu-item span:nth-child(2),
        .sidebar.collapsed .menu-item .arrow,
        .sidebar.collapsed .sidebar-toggle span:last-child {
            display: none !important;
        }

        /* 缩窄模式下菜单项居中 */
        .sidebar.collapsed .menu-item {
            justify-content: center;
            padding: 12px 0;
        }

        /* 缩窄模式下隐藏子菜单 */
        .sidebar.collapsed .submenu {
            display: none;
        }

        /* 缩窄模式悬浮弹出菜单 - 带延迟效果 */
        .sidebar.collapsed .menu-item {
            position: relative;
        }
        .sidebar.collapsed .menu-item .popup-menu {
            display: block;
            visibility: hidden;
            opacity: 0;
            position: fixed;
            left: 47px;
            background: #1a1a2e;
            min-width: 180px;
            border-radius: 8px;
            box-shadow: 2px 2px 12px rgba(0,0,0,0.3);
            z-index: 1000;
            padding: 8px 0;
            transition: visibility 0s linear 0.3s, opacity 0.2s ease;
            pointer-events: none;
        }
        .sidebar.collapsed .menu-item:hover .popup-menu {
            visibility: visible;
            opacity: 1;
            transition-delay: 0s;
            pointer-events: auto;
        }
        .sidebar.collapsed .menu-item .popup-menu:hover {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
        }
        .sidebar.collapsed .menu-item:hover .popup-menu .popup-title {
            padding: 10px 16px;
            color: #4a90e2;
            font-weight: bold;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            font-size: 13px;
        }
        .sidebar.collapsed .menu-item:hover .popup-menu .popup-item {
            padding: 10px 16px;
            cursor: pointer;
            color: rgba(255,255,255,0.7);
            font-size: 13px;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .sidebar.collapsed .menu-item:hover .popup-menu .popup-item:hover {
            background: rgba(74,144,226,0.3);
            color: #fff;
        }

        /* 正常模式下的子菜单 */
        .sidebar:not(.collapsed) .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(0,0,0,0.2);
            margin: 0 12px;
            border-radius: 8px;
        }
        .sidebar:not(.collapsed) .submenu.active {
            max-height: 500px;
        }
        .sidebar:not(.collapsed) .popup-menu {
            display: none;
        }

        /* 侧边栏底部 */
        .sidebar-footer {
            margin-top: auto;
            padding: 16px 0 20px 0;
            border-top: 1px solid rgba(255,255,255,0.1);
        }
        .sidebar-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px 0;
            margin: 0 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            color: rgba(255,255,255,0.7);
            gap: 12px;
        }
        .sidebar-toggle:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }
        .sidebar.collapsed .sidebar-toggle {
            justify-content: center;
        }

        .sidebar-header { padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-header h2 { font-size: 20px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .sidebar-menu { flex: 1; padding: 20px 0; }
        .menu-item {
            padding: 12px 20px;
            margin: 4px 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.7);
        }
        .menu-item:hover { background: rgba(255,255,255,0.1); color: #fff; }
        .menu-item.active { background: #4a90e2; color: #fff; }
        .submenu-item {
            padding: 10px 20px 10px 52px;
            cursor: pointer;
            color: rgba(255,255,255,0.6);
            transition: all 0.2s;
            font-size: 14px;
        }
        .submenu-item:hover { background: rgba(255,255,255,0.05); color: #fff; }
        .submenu-item.active { color: #4a90e2; background: rgba(74,144,226,0.1); }
        .menu-item .arrow { margin-left: auto; font-size: 12px; transition: transform 0.3s; }
        .menu-item.expanded .arrow { transform: rotate(90deg); }

        .main-content {
            flex: 1;
            margin-left: 260px;
            padding: 24px 32px;
            transition: margin-left 0.3s ease;
        }
        .sidebar.collapsed ~ .main-content { margin-left: 60px; }

        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .page-header h1 { color: #1a1a2e; font-size: 28px; font-weight: 600; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
        .stat-card { background: #ffffff26; padding: 24px 20px; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: all 0.3s; border: 1px solid #eee; }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
        .stat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .stat-header span { color: #666; font-size: 14px; font-weight: 500; }
        .stat-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .stat-icon.nodes { background: #e3f2fd; color: #1976d2; }
        .stat-icon.pods { background: #e8f5e9; color: #388e3c; }
        .stat-icon.running { background: #fff3e0; color: #f57c00; }
        .stat-icon.deploy { background: #f3e5f5; color: #7b1fa2; }
        .stat-number { font-size: 36px; font-weight: 700; color: #1a1a2e; }
        .content-section { background: #ffffff26; border-radius: 16px; padding: 24px; margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid #eee; }
        .content-section-1 { background: white; border-radius: 16px; padding: 24px; margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid #eee; }
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .section-header h2 { color: #1a1a2e; font-size: 18px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .badge { background: #e8f5e9; color: #2e7d32; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 500; }
        .table-container { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 14px 12px; background: #f8f9fa; color: #555; font-weight: 600; font-size: 13px; border-bottom: 2px solid #e0e0e0; }
        td { padding: 14px 12px; border-bottom: 1px solid #eee; color: #333; font-size: 14px; }
        tr:hover { background: #f8f9fa; }
        .status-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
        .status-ready, .status-running, .status-active { background: #e8f5e9; color: #2e7d32; }
        .status-not-ready, .status-pending, .status-terminating { background: #fff3e0; color: #e65100; }
        .status-failed, .status-warning { background: #ffebee; color: #c62828; }
        .namespace-tag { background: #e3f2fd; color: #1565c0; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
        .empty-state { text-align: center; padding: 40px; color: #999; }
        .page { display: none; } .page.active { display: block; }
        .footer-note { text-align: center; padding: 20px; color: #999; font-size: 13px; border-top: 1px solid #eee; margin-top: 20px; }

        /* 用户模块样式 */
        .user-info-btn:hover {
            background: #e8f4ff;
            border-color: #1890ff;
        }
        .user-dropdown {
            display: none;
        }
        .user-dropdown.show {
            display: block !important;
        }
        .user-dropdown div:hover {
            background: #f5f7fa;
        }
        .form-group {
            margin-bottom: 16px;
        }
        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: #303133;
        }
        .form-control {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #dcdfe6;
            border-radius: 4px;
            font-size: 14px;
        }
        .form-control:focus {
            outline: none;
            border-color: #409eff;
        }
        .form-control[readonly], .form-control[disabled] {
            background-color: #f5f7fa;
            color: #909399;
        }
        .btn {
            padding: 8px 16px;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }
        .btn-outline {
            background: white;
            border: 1px solid #dcdfe6;
            color: #606266;
        }
        .btn-outline:hover {
            color: #409eff;
            border-color: #409eff;
        }
        .btn-primary {
            background: #409eff;
            color: white;
        }
        .btn-primary:hover {
            background: #66b1ff;
        }
        /* 模态框样式 */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;
}

.modal-content {
    background: white;
    border-radius: 8px;
    width: 1000px;
    max-width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid #e4e7ed;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
}

.modal-close {
    cursor: pointer;
    font-size: 20px;
    color: #909399;
}

.modal-close:hover {
    color: #f56c6c;
}

.modal-body {
    padding: 20px;
}

.modal-footer {
    padding: 16px 20px;
    border-top: 1px solid #e4e7ed;
    display: flex;
    justify-content: flex-end;
    gap: 12px;
}


        /* 版本信息样式 */
.version-info:hover {
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.8) !important;
}

.version-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.version-item {
    border-bottom: 1px solid #e4e7ed;
    padding-bottom: 16px;
}

.version-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.version-item h3 {
    color: #1890ff;
    font-size: 16px;
    margin-bottom: 10px;
}

.version-item ul {
    margin-left: 20px;
    color: #606266;
    font-size: 13px;
    line-height: 1.8;
}

.version-item li {
    margin-bottom: 4px;
}





/* 健康检查卡片 */
.health-check-row {
    margin-bottom: 20px;
}

.health-card {
    background: white;
    border-radius: 16px;
    padding: 16px 20px;
    border: 1px solid #e4e7ed;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.health-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-weight: 600;
    font-size: 15px;
}

.health-status {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
}

.health-status.healthy {
    background: #e8f5e9;
    color: #2e7d32;
}

.health-status.unhealthy {
    background: #ffebee;
    color: #c62828;
}

.health-status.checking {
    background: #fff3e0;
    color: #e65100;
}

.health-detail {
    font-size: 13px;
    color: #666;
    word-break: break-all;
}


/* 确保模态框显示正常 */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;
}

.modal-content {
    background: white;
    border-radius: 8px;
    width: 500px;
    max-width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}


/* 标题特效 */
@keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.1); opacity: 0.8; }
    100% { transform: scale(1); opacity: 1; }
}

@keyframes glow {
    0% { text-shadow: 0 0 5px rgba(167, 139, 250, 0.3); }
    50% { text-shadow: 0 0 15px rgba(167, 139, 250, 0.6); }
    100% { text-shadow: 0 0 5px rgba(167, 139, 250, 0.3); }
}

.sidebar-header h2 span:last-child {
    animation: glow 3s ease-in-out infinite;
}


.logo-text {
    font-size: 16px !important ;
    font-weight: 600;
    background: linear-gradient(135deg, #ebe0e0, #da2d2d) !important ;
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: sweep 2s linear infinite;
    white-space: nowrap;
}

@keyframes sweep {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
}

.logo-icon {
    font-size: 22px;
    animation: wiggle 2s ease-in-out infinite;
}

@keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(10deg); }
    75% { transform: rotate(-10deg); }
}









@keyframes flash {
    0%, 98% {
        opacity: 1;
    }
    100% {
        opacity: 0.5;
    }
}




    </style>
</head>
<body>
<div class="sidebar" id="sidebar">








<div class="sidebar-header">
    <h2 style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 20px; animation: pulse 2s infinite;">☸️</span>
        <span style="font-size: 16px; font-weight: 500; background: linear-gradient(135deg, #ebe0e0, #da2d2d); background-clip: text; -webkit-background-clip: text; color: transparent; letter-spacing: 1px; animation: flash 10s step-end infinite;">
            K8s DevOps 集成中台
        </span>
    </h2>
</div>




    <div class="sidebar-menu">
        <div class="menu-item active" onclick="switchPage('dashboard')">
            <span>📊</span><span>仪表盘</span>
            <div class="popup-menu"><div class="popup-title">仪表盘</div></div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>📦</span><span>工作负载</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">工作负载</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('pods_manager')">Pod 管理(高级)</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('pods')">Pods</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('deployments')">Deployments</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('services')">Services</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('configmaps')">ConfigMaps</div>
            </div>
        </div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('pods_manager')">Pod 管理(高级)</div>
            <div class="submenu-item" onclick="switchPage('pods')">Pods</div>
            <div class="submenu-item" onclick="switchPage('deployments')">Deployments</div>
            <div class="submenu-item" onclick="switchPage('services')">Services</div>
            <div class="submenu-item" onclick="switchPage('configmaps')">ConfigMaps</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>📊</span><span>数据集管理</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">数据集管理</div>
                <div class="popup-item" onclick="event.stopPropagation(); window.open(getConfig('Label Studio'), '_blank')">Label Studio</div>
            </div>
        </div>
        <div class="submenu">
            <div class="submenu-item" onclick="window.open(getConfig('Label Studio'), '_blank')">Label Studio</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>🚀</span><span>集群调度</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">集群调度</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('scheduler')">容器调度（简单）</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('scheduler_advanced')">容器调度（增强版）</div>
            </div>
        </div>
        <div class="submenu">
                <!-- <div class="submenu-item" onclick="switchPage('scheduler')">容器调度（简单）</div> -->
            <div class="submenu-item" onclick="switchPage('scheduler_advanced')">容器调度（增强版）</div>
        </div>





        <!-- 模型中心菜单 -->
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>🤖</span><span>模型中心</span><span class="arrow">▶</span>
            <!-- 下拉菜单内容 (popup-menu) -->
            <div class="popup-menu">
                <div class="popup-title">模型中心</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('model_plaza')">🏛️ 模型广场</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('openwebui')">💬 Open WebUI</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('dify')">🤖 Dify AI</div>
            </div>
        </div>
        <!-- 子菜单 (submenu) -->
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('model_plaza')">🏛️ 模型广场</div>
            <div class="submenu-item" onclick="switchPage('openwebui')">💬 Open WebUI</div>
            <div class="submenu-item" onclick="switchPage('dify')">🤖 Dify AI</div>
        </div>



        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>🐳</span><span>镜像仓库</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">镜像仓库</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('harborImages')">Harbor 镜像</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('harborProjects')">Harbor 项目</div>
                <div class="popup-item" onclick="event.stopPropagation(); window.open(getConfig('Harbor'), '_blank')">Harbor 仓库</div>
            </div>
        </div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('harborImages')">Harbor 镜像</div>
            <div class="submenu-item" onclick="switchPage('harborProjects')">Harbor 项目</div>
            <div class="submenu-item" onclick="window.open(getConfig('Harbor'), '_blank')">Harbor 仓库</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>📈</span><span>系统监控</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">系统监控</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('grafana')">Grafana</div>
                <div class="popup-item" onclick="event.stopPropagation(); window.open(getConfig('Prometheus'), '_blank')">Prometheus</div>
            </div>
        </div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('grafana')">Grafana</div>
            <div class="submenu-item" onclick="window.open(getConfig('Prometheus'), '_blank')">Prometheus</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>⚙️</span><span>集群自动化</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">集群自动化</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('jenkins')">Jenkins CICD</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('pytestweb')">PytestWEB</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('autotest')">自动化测试</div>
            </div>
        </div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('jenkins')">Jenkins CICD</div>
            <div class="submenu-item" onclick="switchPage('pytestweb')">PytestWEB</div>
            <div class="submenu-item" onclick="switchPage('autotest')">自动化测试</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)">
            <span>💾</span><span>集群存储</span><span class="arrow">▶</span>
            <div class="popup-menu">
                <div class="popup-title">集群存储</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('ceph_storage')">Ceph 网盘</div>
                <div class="popup-item" onclick="event.stopPropagation(); switchPage('cephflask')">Ceph 管理</div>
                <div class="popup-item" onclick="event.stopPropagation(); window.open(getConfig('Ceph Web'), '_blank')">Ceph 网页</div>
            </div>
        </div>
        <div class="submenu">

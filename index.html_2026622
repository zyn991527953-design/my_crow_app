// ========== 配置管理 ==========
const API_BASE = '/api';
let componentConfig = [];

async function loadConfig() {
    try {
        const res = await fetch('/api/component-config');
        componentConfig = await res.json();
    } catch(e) { console.error('加载配置失败', e); }
}

function getConfig(name) {
    const c = componentConfig.find(i => i.name === name);
    if (!c) return '#';
    const host = c.host.replace(/^https?:\/\//, '');
    const protocol = c.host.startsWith('https') ? 'https' : 'http';
    return `${protocol}://${host}:${c.port}${c.path || '/'}`;
}

async function saveConfig() {
    try {
        await fetch('/api/component-config', { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(componentConfig) });
        alert('✅ 配置已保存');
    } catch(e) { alert('❌ 保存失败'); }
}

function renderConfigTable() {
    const tbody = document.getElementById('configTableBody');
    if (!tbody) return;
    tbody.innerHTML = componentConfig.map((c, i) => `
        <tr>
            <td><input value="${c.name||''}" onchange="componentConfig[${i}].name=this.value" style="width:120px;padding:6px;border:1px solid #ddd;border-radius:4px;"></td>
            <td><input value="${c.host||''}" onchange="componentConfig[${i}].host=this.value" style="width:140px;padding:6px;border:1px solid #ddd;border-radius:4px;"></td>
            <td><input value="${c.port||''}" onchange="componentConfig[${i}].port=this.value" style="width:80px;padding:6px;border:1px solid #ddd;border-radius:4px;"></td>
            <td><button onclick="componentConfig.splice(${i},1);renderConfigTable()" style="padding:4px 10px;background:#f56c6c;color:white;border:none;border-radius:4px;cursor:pointer;">删除</button></td>
        </tr>
    `).join('');
}

function addConfigRow() { componentConfig.push({name:'New',host:'192.168.138.139',port:'80',path:'/'}); renderConfigTable(); }

// ========== Dashboard 数据 ==========
async function fetchDashboardData() {
    try {
        const [summary, nodes, pods] = await Promise.all([
            fetch(`${API_BASE}/summary`).then(r=>r.json()),
            fetch(`${API_BASE}/nodes`).then(r=>r.json()),
            fetch(`${API_BASE}/pods`).then(r=>r.json())
        ]);
        document.getElementById('statNodes').innerText = summary.nodeCount||0;
        document.getElementById('statPods').innerText = summary.podCount||0;
        document.getElementById('statRunning').innerText = summary.runningPods||0;
        document.getElementById('statDeploy').innerText = summary.deployCount||0;
        renderNodeTable('dashboardNodes', nodes);
        document.getElementById('nodeReadyCount').innerText = `${nodes.filter(n=>n.status==='Ready').length}/${nodes.length} Ready`;
        renderPodTable('dashboardPods', pods.slice(0,10));
        document.getElementById('podTotalCount').innerText = `共 ${pods.length} 个 Pods`;
    } catch(e) { console.error(e); }
}




async function fetchPodsList() { const d=await fetch(`${API_BASE}/pods`).then(r=>r.json()); renderPodTable('podsTable',d); document.getElementById('podListCount').innerText=`共 ${d.length} 个 Pods`; }
async function fetchNodesList() { const d=await fetch(`${API_BASE}/nodes`).then(r=>r.json()); renderNodeTable('nodesTable',d); document.getElementById('nodeListCount').innerText=`共 ${d.length} 个节点`; }
async function fetchNamespacesList() { const d=await fetch(`${API_BASE}/namespaces`).then(r=>r.json()); renderNamespacesTable(d); document.getElementById('nsListCount').innerText=`共 ${d.length} 个命名空间`; }
async function fetchDeploymentsList() { const d=await fetch(`${API_BASE}/deployments`).then(r=>r.json()); renderDeploymentsTable(d); document.getElementById('deployListCount').innerText=`共 ${d.length} 个 Deployments`; }
async function fetchServicesList() { const d=await fetch(`${API_BASE}/services1`).then(r=>r.json()); renderServicesTable(d); document.getElementById('serviceListCount').innerText=`共 ${d.length} 个 Services`; }
async function fetchConfigMapsList() { const d=await fetch(`${API_BASE}/configmaps`).then(r=>r.json()); renderConfigMapsTable(d); document.getElementById('cmListCount').innerText=`共 ${d.length} 个 ConfigMaps`; }
async function fetchEventsList() { const d=await fetch(`${API_BASE}/events1`).then(r=>r.json()); renderEventsTable(d); document.getElementById('eventListCount').innerText=`最近 ${d.length} 条事件`; }

// ========== 渲染函数 ==========
function renderNodeTable(id, nodes) {
    if(!nodes.length){ document.getElementById(id).innerHTML='<div class="empty-state">暂无节点</div>'; return; }
    let h='<table><thead><tr><th>名称</th><th>状态</th><th>版本</th><th>系统</th><th>CPU</th></tr></thead><tbody>';
    nodes.forEach(n=>{
        let statusClass = n.status==='Ready' ? 'status-ready' : 'status-not-ready';
        h+=`<tr><td><strong>${n.name}</strong></td><td><span class="status-badge ${statusClass}">${n.status}</span></td><td>${n.kubelet||'-'}</td><td>${n.os||'-'}</td><td>${n.cpu||'-'}</td></tr>`;
    });
    document.getElementById(id).innerHTML=h+'</tbody></table>';
}

function renderPodTable(id, pods) {
    if(!pods.length){ document.getElementById(id).innerHTML='<div class="empty-state">暂无 Pod</div>'; return; }
    let h='<table class="pod-table"><thead><tr><th>名称</th><th>命名空间</th><th>状态</th><th>IP</th><th>节点</th><th>重启</th><th>操作</th></tr></thead><tbody>';
    pods.forEach(p => {
        let cls = p.status==='Running' ? 'status-running' : (p.status==='Pending' ? 'status-pending' : 'status-failed');
        let deploymentName = p.name;
        const lastDash = deploymentName.lastIndexOf('-');
        const secondLastDash = deploymentName.lastIndexOf('-', lastDash - 1);
        if (secondLastDash !== -1) deploymentName = deploymentName.substring(0, secondLastDash);
        h+=`<tr>
            <td><strong style="cursor:pointer;color:#1890ff;" onclick="viewDeploymentFromPod('${p.namespace}', '${deploymentName}')">${p.name}</strong></td>
            <td><span class="namespace-tag">${p.namespace}</span></td>
            <td><span class="status-badge ${cls}">${p.status}</span></td>
            <td>${p.ip||'-'}</td>
            <td>${p.node||'-'}</td>
            <td>${p.restarts||0}</td>
            <td><button onclick="viewDeploymentFromPod('${p.namespace}', '${deploymentName}')" style="padding:4px 12px;background:#1890ff;color:white;border:none;border-radius:4px;cursor:pointer;">查看 Deployment</button></td>
        </tr>`;
    });
    document.getElementById(id).innerHTML=h+'</tbody></table>';
}





function viewDeploymentFromPod(namespace, deploymentName) {
    const frame = document.getElementById('podsManagerFrame');
    if (frame) frame.src = `/pods_manager.html?namespace=${namespace}&deployment=${deploymentName}`;
    switchPage('pods_manager');
}

function renderNamespacesTable(data) {
    if(!data.length){ document.getElementById('namespacesTable').innerHTML='<div class="empty-state">暂无命名空间</div>'; return; }
    let h='<table><thead><tr><th>名称</th><th>状态</th></tr></thead><tbody>';
    data.forEach(n=>{ h+=`<tr><td><strong>${n.name}</strong></td><td><span class="status-badge ${n.status==='Active'?'status-active':''}">${n.status}</span></td></tr>`; });
    document.getElementById('namespacesTable').innerHTML=h+'</tbody></tr>';
}

function renderDeploymentsTable(data) {
    if(!data.length){ document.getElementById('deploymentsTable').innerHTML='<div class="empty-state">暂无 Deployment</div>'; return; }
    let h='<table><thead><tr><th>名称</th><th>命名空间</th><th>副本</th><th>可用</th><th>就绪</th></tr></thead><tbody>';
    data.forEach(d=>{ h+=`<tr><td><strong>${d.name}</strong></td><td><span class="namespace-tag">${d.namespace}</span></td><td>${d.replicas||0}</td><td>${d.availableReplicas||0}</td><td>${d.readyReplicas||0}</td></tr>`; });
    document.getElementById('deploymentsTable').innerHTML=h+'</tbody></tr>';
}


function renderServicesTable(data) {
    if(!data.length){ document.getElementById('servicesTable').innerHTML='<div class="empty-state">暂无 Service</div>'; return; }
    let h='<table class="services-table"><thead><tr><th>名称</th><th>命名空间</th><th>类型</th><th>Cluster IP</th><th>端口</th></tr></thead><tbody>';
    data.forEach(s=>{
        h+=`<tr>
            <td><strong>${s.name||'-'}</strong></td>
            <td><span class="namespace-tag">${s.namespace||'-'}</span></td>
            <td>${s.type||'-'}</td>
            <td>${s.clusterIP||'-'}</td>
            <td>${s.port||'-'}</td>
        </tr>`;
    });
    document.getElementById('servicesTable').innerHTML=h+'</tbody></table>';
}
function renderConfigMapsTable(data) {
    if(!data.length){ document.getElementById('configmapsTable').innerHTML='<div class="empty-state">暂无 ConfigMap</div>'; return; }
    let h='<table><thead><tr><th>名称</th><th>命名空间</th><th>数据条目</th></tr></thead><tbody>';
    data.forEach(c=>{ h+=`<tr><td><strong>${c.name||'-'}</strong></td><td><span class="namespace-tag">${c.namespace||'-'}</span></td><td>${c.dataCount||0}</td></tr>`; });
    document.getElementById('configmapsTable').innerHTML=h+'</tbody><tr>';
}

function renderEventsTable(data) {
    if(!data.length){ document.getElementById('eventsTable').innerHTML='<div class="empty-state">暂无事件</div>'; return; }
    let h='<table><thead><tr><th>类型</th><th>原因</th><th>命名空间</th><th>消息</th><th>时间</th></tr></thead><tbody>';
    data.forEach(e=>{ let cls=e.type==='Warning'?'status-warning':'status-ready'; h+=`<tr><td><span class="status-badge ${cls}">${e.type||'-'}</span></td><td>${e.reason||'-'}</td><td>${e.namespace||'-'}</td><td>${e.message||'-'}</td><td>${e.timestamp||'-'}</td></tr>`; });
    document.getElementById('eventsTable').innerHTML=h+'</tbody></table>';
}

// ========== 调度页面 ==========
async function loadSchedulerPage() { setTimeout(async()=>{await loadImageSelect();await loadNodeSelect();},200); }

window.allImages = [];
window.selectedImage = '';

async function loadImageSelect() {
    const H = "192.168.138.139:30002";
    const input = document.getElementById("imageSearch");
    if (!input) return;
    input.value = "⏳ 加载镜像...";
    input.disabled = true;
    try {
        const r = await fetch("/api/harbor/cached-images");
        const d = await r.json();
        window.allImages = d.map(img => ({ name: img.name, tag: img.tag, full: `${H}/${img.name}:${img.tag}` }));
        input.value = "";
        input.placeholder = `🔍 共 ${window.allImages.length} 个镜像，输入关键字搜索...`;
    } catch(e) { input.placeholder = "加载失败"; }
    finally { input.disabled = false; }
}

function filterImages() {
    const keyword = document.getElementById('imageSearch').value.toLowerCase();
    const dropdown = document.getElementById('imageDropdown');
    const filtered = window.allImages.filter(img => img.name.toLowerCase().includes(keyword) || img.tag.toLowerCase().includes(keyword));
    dropdown.innerHTML = filtered.slice(0, 50).map(img => `<div onclick="selectImage('${img.full}', '${img.name}:${img.tag}')" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid #eee;">${img.name}:${img.tag}</div>`).join('') || '<div style="padding:10px;color:#999;">无匹配镜像</div>';
    dropdown.style.display = 'block';
}

function selectImage(full, label) {
    document.getElementById('imageSearch').value = label;
    document.getElementById('imageSelect').value = full;
    document.getElementById('imageDropdown').style.display = 'none';
    window.selectedImage = full;
}

function showImageList() {
    if (window.allImages.length > 0 && !document.getElementById('imageSearch').value) {
        const dropdown = document.getElementById('imageDropdown');
        dropdown.innerHTML = window.allImages.slice(0, 50).map(img => `<div onclick="selectImage('${img.full}', '${img.name}:${img.tag}')" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid #eee;">${img.name}:${img.tag}</div>`).join('');
        dropdown.style.display = 'block';
    }
}

document.addEventListener('click', (e) => {
    if (!e.target.closest('#imageSearch') && !e.target.closest('#imageDropdown')) {
        document.getElementById('imageDropdown').style.display = 'none';
    }
});

async function loadNodeSelect() {
    const s=document.getElementById('nodeSelect');
    if(!s)return;
    try{
        const nodes=await fetch('/api/nodes').then(r=>r.json());
        s.innerHTML='<option value="">-- 自动调度 --</option>';
        nodes.forEach(n=>{if(n.status==='Ready')s.innerHTML+=`<option value="${n.name}">${n.name}</option>`;});
    }catch(e){}
}

async function createDeployment() {
    const image=document.getElementById('imageSelect').value || window.selectedImage;
    const cpu=document.getElementById('cpuCores').value;
    const memory=document.getElementById('memoryMB').value;
    const node=document.getElementById('nodeSelect').value;
    if(!image){alert('请选择镜像');return;}
    const deployName='scheduled-'+Date.now();
    const deployment={metadata:{name:deployName},spec:{replicas:1,selector:{matchLabels:{app:deployName}},template:{metadata:{labels:{app:deployName}},spec:{containers:[{name:'app',image:image,imagePullPolicy:'IfNotPresent',resources:{requests:{cpu:cpu,memory:memory+'Mi'},limits:{cpu:cpu,memory:(parseInt(memory)*2)+'Mi'}}}]}}}};
    if(node) deployment.spec.template.spec.nodeName=node;
    try{
        const res=await fetch(`/api/namespaces/default/deployments`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(deployment)});
        if(res.ok){alert('✅ 部署成功！\n名称: '+deployName);switchPage('deployments');}
        else{const err=await res.text();alert('❌ 部署失败: '+err);}
    }catch(e){alert('❌ 部署失败: '+e.message);}
}

// ========== Harbor ==========
window.harborPage = 1; window.harborPageSize = 10; window.harborAllImages = [];

async function loadHarborImages1() {
    const p = document.getElementById('harborProjectSelect').value;
    window.harborAllImages = await fetchHarborImages(p);
    window.harborPage = 1;
    renderHarborImagesPage();
    document.getElementById('harborImageCount').innerText = `共 ${window.harborAllImages.length} 个镜像`;
}


async function loadHarborImages() {
    const project = document.getElementById('harborProjectSelect').value;
    if (!project) return;

    window.harborAllImages = await fetchHarborImages(project);
    window.harborPage = 1;
    renderHarborImagesPage();
    document.getElementById('harborImageCount').innerText = `共 ${window.harborAllImages.length} 个镜像`;
}


function renderHarborImagesPage() {
    const start = (window.harborPage - 1) * window.harborPageSize;
    const pageImages = window.harborAllImages.slice(start, start + window.harborPageSize);
    renderHarborImagesTable(pageImages);
    renderHarborPagination();
}

function renderHarborImagesTable1(images) {
    const c = document.getElementById('harborImagesTable');
    if (!images || !images.length) { c.innerHTML = '<div class="empty-state">暂无镜像</div>'; return; }
    let h = '<tr><thead><tr><th>镜像名称</th><th>项目</th><th>拉取次数</th><th>操作</th></tr></thead><tbody>';
    images.forEach(img => {
        h += `<tr><td><strong>${img.name.split('/').pop()}</strong></td><td>${img.project_id}</td><td>${img.pull_count || 0}</td><td><button onclick="deployImageFromHarbor('${img.name}')" style="padding:4px 12px;background:#4a90e2;color:white;border:none;border-radius:4px;">部署</button></td></tr>`;
    });
    c.innerHTML = h + '</tbody></tr>';
}


function renderHarborImagesTable(images) {
    const c = document.getElementById('harborImagesTable');
    if (!c) return;
    if (!images || images.length === 0) {
        c.innerHTML = '<div class="empty-state">暂无镜像</div>';
        return;
    }
    let h = '<table class="harbor-table"><thead><tr><th>镜像名称</th><th>项目</th><th>拉取次数</th><th>操作</th></tr></thead><tbody>';
    images.forEach(img => {
        let imageShortName = img.name.split('/').pop();
        let fullImageName = img.name;
        h += `<tr>
            <td><strong>${escapeHtml(imageShortName)}</strong></td>
            <td>${img.project_id || 'library'}</td>
            <td>${img.pull_count || 0}</td>
            <td>
                <button onclick="deployImageFromHarbor('${escapeHtml(fullImageName)}')" style="padding:4px 12px;background:#4a90e2;color:white;border:none;border-radius:4px;cursor:pointer;margin-right:5px;">🚀 部署</button>
                <button onclick="showTagList('${escapeHtml(fullImageName)}')" style="padding:4px 12px;background:#67c23a;color:white;border:none;border-radius:4px;cursor:pointer;">📥 下载</button>
            </td>
        </tr>`;
    });
    c.innerHTML = h + '</tbody><tr>';
}

// 显示 tag 列表选择框
async function showTagList(imageName) {
    console.log('showTagList called with:', imageName);

    let project = "library";
    let repo = imageName;
    let slashPos = imageName.indexOf('/');
    if (slashPos !== -1) {
        project = imageName.substring(0, slashPos);
        repo = imageName.substring(slashPos + 1);
    }

    try {
        const response = await fetch(`/api/harbor/repositories/${project}/${repo}/tags`);
        const tags = await response.json();

        console.log('获取到的 tags:', tags);

        if (!tags || tags.length === 0) {
            alert('该镜像没有可用的 tag');
            return;
        }

        // 创建弹窗
        const modalDiv = document.createElement('div');
        modalDiv.id = 'tagSelectModal';
        modalDiv.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10000; display: flex; justify-content: center; align-items: center;';

        modalDiv.innerHTML = `
            <div style="background: white; border-radius: 8px; width: 400px; max-width: 90%;">
                <div style="padding: 16px 20px; border-bottom: 1px solid #e4e7ed; display: flex; justify-content: space-between;">
                    <span>📦 选择镜像 Tag - ${repo}</span>
                    <span onclick="document.getElementById('tagSelectModal')?.remove()" style="cursor: pointer; font-size: 20px;">&times;</span>
                </div>
                <div style="padding: 20px;">
                    <label>请选择要下载的 Tag</label>
                    <select id="tagSelect" style="width: 100%; padding: 8px; margin-top: 8px; border: 1px solid #ddd; border-radius: 4px;">
                        ${tags.map(t => `<option value="${t}">${t}</option>`).join('')}
                    </select>
                </div>
                <div style="padding: 16px 20px; border-top: 1px solid #e4e7ed; display: flex; justify-content: flex-end; gap: 10px;">
                    <button onclick="document.getElementById('tagSelectModal')?.remove()" style="padding: 8px 16px; background: #909399; color: white; border: none; border-radius: 4px; cursor: pointer;">取消</button>
                    <button onclick="downloadWithTag('${imageName}')" style="padding: 8px 16px; background: #409eff; color: white; border: none; border-radius: 4px; cursor: pointer;">下载</button>
                </div>
            </div>
        `;

        // 移除已存在的弹窗
        const existing = document.getElementById('tagSelectModal');
        if (existing) existing.remove();

        document.body.appendChild(modalDiv);

    } catch(e) {
        console.error('获取 tag 失败:', e);
        alert('获取 tag 列表失败: ' + e.message);
    }
}




function closeTagModal() {
    const modal = document.getElementById('tagSelectModal');
    if (modal) modal.remove();
}

function downloadWithTag(imageName) {
    const tagSelect = document.getElementById('tagSelect');
    if (!tagSelect) {
        alert('未找到 tag 选择器');
        return;
    }
    const tag = tagSelect.value;
    if (!tag) {
        alert('请选择 tag');
        return;
    }
    // 关闭弹窗
    const modal = document.getElementById('tagSelectModal');
    if (modal) modal.remove();

    const fullImageWithTag = `${imageName}:${tag}`;

    if (!confirm(`确定要下载镜像 "${fullImageWithTag}" 吗？`)) return;

    fetch(`/api/harbor/download-image?image=${encodeURIComponent(fullImageWithTag)}`)
        .then(async response => {
            if (response.ok) {
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${imageName.replace(/\//g, '_')}_${tag}.tar`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
                alert('✅ 镜像下载已开始');
            } else {
                const error = await response.json();
                alert('❌ 下载失败: ' + (error.error || '未知错误'));
            }
        })
        .catch(e => alert('❌ 下载失败: ' + e.message));
}


function renderHarborImagesTable2(images) {
    const c = document.getElementById('harborImagesTable');
    if (!images || !images.length) {
        c.innerHTML = '<div class="empty-state">暂无镜像</div>';
        return;
    }
    let h = '<table class="harbor-table"><thead><tr><th>镜像名称</th><th>项目</th><th>拉取次数</th><th>操作</th></tr></thead><tbody>';
    images.forEach(img => {
        let imageShortName = img.name.split('/').pop();
        h += `<tr>
            <td><strong>${imageShortName}</strong></td>
            <td>${img.project_id || 'library'}</td>
            <td>${img.pull_count || 0}</td>
            <td><button onclick="deployImageFromHarbor('${img.name}')" style="padding:4px 12px;background:#4a90e2;color:white;border:none;border-radius:4px;cursor:pointer;">部署</button></td>
        </tr>`;
    });
    c.innerHTML = h + '</tbody></table>';
}


function renderHarborPagination() {
    const total = Math.ceil(window.harborAllImages.length / window.harborPageSize);
    const c = document.getElementById('harborImagesTable');
    const old = document.getElementById('harborPagination');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'harborPagination';
    div.style.cssText = 'display:flex;justify-content:center;gap:8px;margin-top:15px;';
    div.innerHTML = `
        <button onclick="window.harborPage=1;renderHarborImagesPage()" ${window.harborPage===1 ? 'disabled' : ''}>首页</button>
        <button onclick="if(window.harborPage>1){window.harborPage--;renderHarborImagesPage()}" ${window.harborPage===1 ? 'disabled' : ''}>上一页</button>
        <span>第 ${window.harborPage}/${total} 页</span>
        <button onclick="if(window.harborPage<${total}){window.harborPage++;renderHarborImagesPage()}" ${window.harborPage===total ? 'disabled' : ''}>下一页</button>
        <button onclick="window.harborPage=${total};renderHarborImagesPage()" ${window.harborPage===total ? 'disabled' : ''}>末页</button>`;
    c.parentNode.insertBefore(div, c.nextSibling);
}

function deployImageFromHarbor(imageName) {
    const cleanImageName = imageName.replace("library/", "");
    sessionStorage.setItem('pendingImage', cleanImageName);
    switchPage('scheduler_advanced');
    setTimeout(() => {
        const iframe = document.querySelector('#scheduler_advanced iframe');
        if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage({ type: 'selectImage', imageName: cleanImageName }, '*');
        }
    }, 500);
}

async function loadHarborProjectsPage1() { try { const p = await fetchHarborProjects(); renderHarborProjectsTable(p); } catch(e) {} }




async function loadHarborProjectsPage() {
    // 等待元素出现
    let retries = 0;
    let tableContainer = document.getElementById('harborProjectsTable');
    while (!tableContainer && retries < 20) {
        await new Promise(resolve => setTimeout(resolve, 50));
        tableContainer = document.getElementById('harborProjectsTable');
        retries++;
    }

    if (!tableContainer) {
        console.error('harborProjectsTable 元素不存在');
        return;
    }

    try {
        const projects = await fetchHarborProjects();
        renderHarborProjectsTable(projects);

        // 同时更新镜像页面的下拉框
        const projectSelect = document.getElementById('harborProjectSelect');
        if (projectSelect && projects && projects.length > 0) {
            const currentValue = projectSelect.value;
            projectSelect.innerHTML = projects.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
            if (projects.some(p => p.name === currentValue)) {
                projectSelect.value = currentValue;
            } else if (projects.some(p => p.name === 'library')) {
                projectSelect.value = 'library';
            } else if (projects.length > 0) {
                projectSelect.value = projects[0].name;
            }
        }
    } catch(e) {
        console.error('加载项目失败:', e);
        if (tableContainer) {
            tableContainer.innerHTML = '<div class="empty-state">加载失败</div>';
        }
    }
}




async function loadHarborProjectsPage33() {
    try {
        const projects = await fetchHarborProjects();

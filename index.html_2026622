function renderHarborImagesTable(images) {
    const c = document.getElementById('harborImagesTable');
    if (!images || !images.length) {
        c.innerHTML = '<div class="empty-state">暂无镜像</div>';
        return;
    }
    let h = '<table class="harbor-table"><thead><tr><th>镜像名称</th><th>项目</th><th>拉取次数</th><th>操作</th></tr></thead><tbody>';
    images.forEach(img => {
        let imageShortName = img.name.split('/').pop();
        let fullImageName = img.name;
        h += `<tr>
            <td><strong>${escapeHtml(imageShortName)}</strong></td>
            <td>${img.project_id || 'library'}</td>
            <td>${img.pull_count || 0}</td>
            <td>
                <button onclick="deployImageFromHarbor('${escapeHtml(fullImageName)}')" style="padding:4px 12px;background:#4a90e2;color:white;border:none;border-radius:4px;cursor:pointer;margin-right:5px;">🚀 部署</button>
                <button onclick="showTagList('${escapeHtml(fullImageName)}')" style="padding:4px 12px;background:#67c23a;color:white;border:none;border-radius:4px;cursor:pointer;">📥 下载</button>
            </td>
        </tr>`;
    });
    c.innerHTML = h + '</tbody></table>';
}



function renderHarborProjectsTable2(projects) {
    const c = document.getElementById('harborProjectsTable');
    if (!projects || !projects.length) {
        c.innerHTML = '<div class="empty-state">暂无项目</div>';
        return;
    }
    let h = '<table class="harbor-table"><thead><tr><th>项目名称</th><th>访问级别</th><th>镜像数量</th><th>操作</th></tr></thead><tbody>';
    projects.forEach(p => {
        const repoCount = p.repo_count || 0;
        const isPublic = p.metadata?.public === 'true' ? '公开' : '私有';
        // 如果有镜像，禁用删除按钮
        const deleteDisabled = repoCount > 0;
        const deleteTitle = deleteDisabled ? `包含 ${repoCount} 个镜像，无法删除` : '删除项目';
        const deleteButton = deleteDisabled
            ? `<button style="padding:4px 12px;background:#c0c4cc;color:white;border:none;border-radius:4px;cursor:not-allowed;" disabled title="${deleteTitle}">🗑️ 删除</button>`
            : `<button onclick="deleteHarborProject('${p.name}')" style="padding:4px 12px;background:#f56c6c;color:white;border:none;border-radius:4px;cursor:pointer;" title="${deleteTitle}">🗑️ 删除</button>`;

        h += `<tr>
            <td><strong>${p.name}</strong></td>
            <td>${isPublic}</td>
            <td>${repoCount}</td>
            <td>${deleteButton}</td>
        </tr>`;
    });
    c.innerHTML = h + '</tbody></table>';
}

// 删除 Harbor 项目
async function deleteHarborProject(projectName) {
    // 二次确认
    const confirmMsg = `⚠️ 确定要删除项目 "${projectName}" 吗？\n\n此操作不可撤销！`;
    if (!confirm(confirmMsg)) return;

    // 输入确认
    const inputConfirm = prompt(`请输入 "${projectName}" 以确认删除：`);
    if (inputConfirm !== projectName) {
        alert('删除已取消，名称不匹配');
        return;
    }

    const deleteBtn = event.target;
    const originalText = deleteBtn.innerText;
    deleteBtn.disabled = true;
    deleteBtn.innerText = '删除中...';

    try {
        const response = await fetch(`/api/harbor/projects/${encodeURIComponent(projectName)}`, {
            method: 'DELETE'
        });

        const result = await response.json();

        if (result.success) {
            alert('✅ 项目删除成功！');
            // 刷新项目列表
            loadHarborProjectsPage();
            // 同时刷新镜像下拉框
            const projects = await fetchHarborProjects();
            const projectSelect = document.getElementById('harborProjectSelect');
            if (projectSelect && projects && projects.length > 0) {
                projectSelect.innerHTML = projects.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
                if (projects.some(p => p.name === 'library')) {
                    projectSelect.value = 'library';
                    loadHarborImages();
                }
            }
        } else {
            alert('❌ 删除失败: ' + (result.error || result.message));
        }
    } catch(e) {
        alert('❌ 请求失败: ' + e.message);
    } finally {
        deleteBtn.disabled = false;
        deleteBtn.innerText = originalText;
    }
}

function refreshHarborImages() { loadHarborImages(); }



// 专门用于初始化镜像列表（不需要等待项目表格）
async function initHarborImages() {
    try {
        const projects = await fetchHarborProjects();
        const projectSelect = document.getElementById('harborProjectSelect');
        if (projectSelect && projects && projects.length > 0) {
            projectSelect.innerHTML = projects.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
            if (projects.some(p => p.name === 'library')) {
                projectSelect.value = 'library';
            } else if (projects.length > 0) {
                projectSelect.value = projects[0].name;
            }
            // 加载镜像
            loadHarborImages();
        }
    } catch(e) {
        console.error('初始化镜像失败:', e);
    }
}




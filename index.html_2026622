        cephflask:'💾 Ceph 管理', config:'⚙️ 组件配置', scheduler_advanced:'🚀 容器调度（增强版）',
        ceph_storage:'💾 Ceph 网盘', money:'💰 大盘星图'
    };
    document.getElementById('pageTitle').innerText = titles[pageId] || pageId;

    const loaders = {
        dashboard: fetchDashboardData, pods: fetchPodsList, nodes: fetchNodesList,
        deployments: fetchDeploymentsList, services: fetchServicesList, configmaps: fetchConfigMapsList,
        namespaces: fetchNamespacesList, events: fetchEventsList, scheduler: loadSchedulerPage,
        harborImages: () => {
            // 确保先加载项目列表，再加载镜像
            loadHarborProjectsPage();
        },
        harborProjects: loadHarborProjectsPage,
        config: renderConfigTable,
        autotest: autoLoginAutotest
    };

    if (loaders[pageId]) {
        loaders[pageId]();
    }

    if (pageId === 'grafana') {
        const c = document.getElementById('grafana');
        if (!c.querySelector('iframe')) {
            c.innerHTML = '<iframe src="/grafana/?theme=light" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe>';
        }
    }
    if (pageId === 'cephflask') {
        document.getElementById('cephflaskIframe').src = getConfig('Ceph Flask');
    }
}






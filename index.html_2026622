// 显示新建项目模态框
function showCreateProjectModal() {
    document.getElementById('newProjectName').value = '';
    document.getElementById('newProjectPublic').value = 'false';
    document.getElementById('newProjectStorage').value = '';
    document.getElementById('createProjectModal').style.display = 'flex';
}

function closeCreateProjectModal() {
    document.getElementById('createProjectModal').style.display = 'none';
}

// 创建 Harbor 项目
async function createHarborProject() {
    const projectName = document.getElementById('newProjectName').value.trim();
    const isPublic = document.getElementById('newProjectPublic').value === 'true';
    const storageLimit = document.getElementById('newProjectStorage').value;

    if (!projectName) {
        alert('请输入项目名称');
        return;
    }

    // 验证项目名称格式
    if (!/^[a-z0-9_-]+$/.test(projectName)) {
        alert('项目名称只能包含小写字母、数字、下划线、连字符');
        return;
    }

    const createBtn = event.target;
    const originalText = createBtn.innerText;
    createBtn.disabled = true;
    createBtn.innerText = '创建中...';

    try {
        const response = await fetch('/api/harbor/projects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                project_name: projectName,
                public: isPublic,
                storage_limit: storageLimit ? parseInt(storageLimit) : -1
            })
        });

        const result = await response.json();

        if (result.success) {
            alert('✅ 项目创建成功！');
            closeCreateProjectModal();
            // 刷新项目列表
            loadHarborProjectsPage();
        } else {
            alert('❌ 创建失败: ' + (result.error || result.message));
        }
    } catch(e) {
        alert('❌ 请求失败: ' + e.message);
    } finally {
        createBtn.disabled = false;
        createBtn.innerText = originalText;
    }
}


// 刷新所有健康检查
function refreshClusterHealth() {
    checkAPIServerHealth();
    checkClusterHealth();
}





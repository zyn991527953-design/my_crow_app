<script>
// ========== 用户信息相关 ========== configure
let currentUser = null;

async function loadCurrentUser() {
    try {
        const response = await fetch('/api/auth/me');
        const data = await response.json();
        if (data.code === 0 && data.data) {
            currentUser = data.data;
            document.getElementById('currentUsername').innerText = currentUser.username || '用户';
            document.getElementById('dropdownUsername').innerText = currentUser.fullname || currentUser.username || '-';
            document.getElementById('dropdownRole').innerText = currentUser.role || 'user';
        } else {
            currentUser = {
                username: 'admin',
                fullname: 'System Administrator',
                group: 'administrators',
                email: 'admin@example.com',
                role: 'admin'
            };
            document.getElementById('currentUsername').innerText = 'admin';
            document.getElementById('dropdownUsername').innerText = 'System Administrator';
            document.getElementById('dropdownRole').innerText = 'admin';
        }
    } catch(e) {
        console.error('获取用户信息失败:', e);
        currentUser = {
            username: 'admin',
            fullname: 'System Administrator',
            group: 'administrators',
            email: 'admin@example.com',
            role: 'admin'
        };
        document.getElementById('currentUsername').innerText = 'admin';
        document.getElementById('dropdownUsername').innerText = 'System Administrator';
        document.getElementById('dropdownRole').innerText = 'admin';
    }
}


window.showUploadImageModal = async function() {
    console.log('showUploadImageModal called');
    let modal = document.getElementById('uploadImageModal');

    // 如果模态框不存在，创建它
    if (!modal) {
        const modalHtml = `
            <div id="uploadImageModal" class="modal" style="display: none;">
                <div class="modal-content" style="max-width: 600px;">
                    <div class="modal-header">
                        <span>📤 上传镜像到 Harbor</span>
                        <span class="modal-close" onclick="closeUploadImageModal()">&times;</span>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label>选择项目</label>
                            <select id="uploadProject" class="form-control"></select>
                        </div>
                        <div class="form-group">
                            <label>镜像名称</label>
                            <input type="text" id="uploadImageName" class="form-control" placeholder="例如: myapp">
                            <small style="color:#909399;">只能包含小写字母、数字、下划线、连字符</small>
                        </div>
                        <div class="form-group">
                            <label>镜像标签</label>
                            <input type="text" id="uploadImageTag" class="form-control" placeholder="例如: latest" value="latest">
                        </div>
                        <div class="form-group">
                            <label>选择镜像文件 (.tar)</label>
                            <input type="file" id="uploadTarFile" accept=".tar" class="form-control">
                            <small style="color:#909399;">支持 docker save 导出的 tar 包</small>
                        </div>
                        <div id="uploadProgress" style="display: none;">
                            <div class="progress-bar"><div class="progress-fill" id="uploadProgressFill"></div></div>
                            <div id="uploadStatus" style="margin-top: 8px; font-size: 12px; color: #666;"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline" onclick="closeUploadImageModal()">取消</button>
                        <button class="btn btn-primary" onclick="uploadImage()" id="uploadBtn">开始上传</button>
                    </div>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        modal = document.getElementById('uploadImageModal');
    }

    if (!modal) {
        alert('上传功能初始化失败');
        return;
    }

    // 加载项目列表
    try {
        const response = await fetch('/api/harbor/projects');
        const projects = await response.json();
        const select = document.getElementById('uploadProject');
        if (select && projects && projects.length) {
            select.innerHTML = projects.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
        }
    } catch(e) {
        console.error('加载项目失败:', e);
    }

    // 清空表单
    const nameInput = document.getElementById('uploadImageName');
    const tagInput = document.getElementById('uploadImageTag');
    const fileInput = document.getElementById('uploadTarFile');
    const progressDiv = document.getElementById('uploadProgress');

    if (nameInput) nameInput.value = '';
    if (tagInput) tagInput.value = 'latest';
    if (fileInput) fileInput.value = '';
    if (progressDiv) progressDiv.style.display = 'none';

    modal.style.display = 'flex';
};

// 同时确保 closeUploadImageModal 和 uploadImage 函数存在
window.closeUploadImageModal = function() {
    const modal = document.getElementById('uploadImageModal');
    if (modal) modal.style.display = 'none';
};

window.uploadImage = async function() {
    const project = document.getElementById('uploadProject')?.value;
    const imageName = document.getElementById('uploadImageName')?.value.trim();
    const imageTag = document.getElementById('uploadImageTag')?.value.trim();
    const fileInput = document.getElementById('uploadTarFile');
    const file = fileInput?.files[0];

    if (!project) { alert('请选择项目'); return; }
    if (!imageName) { alert('请输入镜像名称'); return; }
    if (!imageTag) { alert('请输入镜像标签'); return; }
    if (!file) { alert('请选择 tar 文件'); return; }
    if (!/^[a-z0-9_-]+$/.test(imageName)) {
        alert('镜像名称只能包含小写字母、数字、下划线、连字符');
        return;
    }

    const formData = new FormData();
    formData.append('project', project);
    formData.append('image_name', imageName);
    formData.append('image_tag', imageTag);
    formData.append('file', file);

    const uploadBtn = document.getElementById('uploadBtn');
    const progressDiv = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('uploadProgressFill');
    const statusDiv = document.getElementById('uploadStatus');

    uploadBtn.disabled = true;
    uploadBtn.innerText = '上传中...';
    progressDiv.style.display = 'block';

    const xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/harbor/upload-image');
    xhr.upload.onprogress = (e) => {
        if (e.lengthComputable) {
            const percent = Math.round((e.loaded / e.total) * 100);
            progressFill.style.width = percent + '%';
            statusDiv.innerText = `上传进度: ${percent}%`;
        }
    };
    xhr.onload = () => {
        uploadBtn.disabled = false;
        uploadBtn.innerText = '开始上传';
        if (xhr.status === 200) {
            try {
                const result = JSON.parse(xhr.responseText);
                if (result.success) {
                    alert('✅ 镜像上传成功！');
                    closeUploadImageModal();
                    loadHarborImages();
                } else {
                    alert('❌ 上传失败: ' + result.error);
                }
            } catch(e) {
                alert('❌ 上传失败: ' + e.message);
            }
        } else {
            alert('❌ 上传失败: HTTP ' + xhr.status);
        }
    };
    xhr.onerror = () => {
        uploadBtn.disabled = false;
        uploadBtn.innerText = '开始上传';
        alert('❌ 上传失败: 网络错误');
    };
    xhr.send(formData);
};


function createUploadModal() {
    const modalHtml = `
        <div id="uploadImageModal" class="modal" style="display: none;">
            <div class="modal-content" style="max-width: 600px;">
                <div class="modal-header">
                    <span>📤 上传镜像到 Harbor</span>
                    <span class="modal-close" onclick="closeUploadImageModal()">&times;</span>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>选择项目</label>
                        <select id="uploadProject" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label>镜像名称</label>
                        <input type="text" id="uploadImageName" class="form-control" placeholder="例如: myapp">
                        <small style="color:#909399;">只能包含小写字母、数字、下划线、连字符</small>
                    </div>
                    <div class="form-group">
                        <label>镜像标签</label>
                        <input type="text" id="uploadImageTag" class="form-control" placeholder="例如: latest" value="latest">
                    </div>
                    <div class="form-group">
                        <label>选择镜像文件 (.tar)</label>
                        <input type="file" id="uploadTarFile" accept=".tar" class="form-control">
                        <small style="color:#909399;">支持 docker save 导出的 tar 包</small>
                    </div>
                    <div id="uploadProgress" style="display: none;">
                        <div class="progress-bar"><div class="progress-fill" id="uploadProgressFill"></div></div>
                        <div id="uploadStatus" style="margin-top: 8px; font-size: 12px; color: #666;"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline" onclick="closeUploadImageModal()">取消</button>
                    <button class="btn btn-primary" onclick="uploadImage()" id="uploadBtn">开始上传</button>
                </div>
            </div>
        </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modalHtml);
}







// 显示上传模态框
async function showUploadImageModal1() {
    // 加载项目列表
    const projects = await fetchHarborProjects();
    const select = document.getElementById('uploadProject');
    if (projects && projects.length) {
        select.innerHTML = projects.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
    }
    document.getElementById('uploadImageName').value = '';
    document.getElementById('uploadImageTag').value = 'latest';
    document.getElementById('uploadTarFile').value = '';
    document.getElementById('uploadProgress').style.display = 'none';
    document.getElementById('uploadModal').style.display = 'flex';
}

function closeUploadImageModal1() {
    document.getElementById('uploadModal').style.display = 'none';
}



function closeUploadImageModal() {
    const modal = document.getElementById('uploadImageModal');
    if (modal) {
        modal.style.display = 'none';
    }
}


// 上传镜像
async function uploadImage() {
    const project = document.getElementById('uploadProject').value;
    const imageName = document.getElementById('uploadImageName').value.trim();
    const imageTag = document.getElementById('uploadImageTag').value.trim();
    const fileInput = document.getElementById('uploadTarFile');
    const file = fileInput.files[0];

    if (!project) {
        alert('请选择项目');
        return;
    }
    if (!imageName) {
        alert('请输入镜像名称');
        return;
    }
    if (!imageTag) {
        alert('请输入镜像标签');
        return;
    }
    if (!file) {
        alert('请选择 tar 文件');
        return;
    }

    // 验证镜像名称格式
    if (!/^[a-z0-9_-]+$/.test(imageName)) {
        alert('镜像名称只能包含小写字母、数字、下划线、连字符');
        return;
    }

    const formData = new FormData();
    formData.append('project', project);
    formData.append('image_name', imageName);
    formData.append('image_tag', imageTag);
    formData.append('file', file);

    const uploadBtn = document.getElementById('uploadBtn');
    const progressDiv = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('uploadProgressFill');
    const statusDiv = document.getElementById('uploadStatus');

    uploadBtn.disabled = true;
    uploadBtn.innerText = '上传中...';
    progressDiv.style.display = 'block';

    try {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/harbor/upload-image');

        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressFill.style.width = percent + '%';
                statusDiv.innerText = `上传进度: ${percent}%`;
            }
        };

        xhr.onload = () => {
            if (xhr.status === 200) {
                const result = JSON.parse(xhr.responseText);
                if (result.success) {
                    alert('✅ 镜像上传成功！');
                    closeUploadImageModal();
                    loadHarborImages(); // 刷新列表
                } else {
                    alert('❌ 上传失败: ' + result.error);
                }
            } else {
                alert('❌ 上传失败: HTTP ' + xhr.status);
            }
            uploadBtn.disabled = false;
            uploadBtn.innerText = '开始上传';
        };

        xhr.onerror = () => {
            alert('❌ 上传失败: 网络错误');
            uploadBtn.disabled = false;
            uploadBtn.innerText = '开始上传';
        };

        xhr.send(formData);

    } catch(e) {
        alert('❌ 上传失败: ' + e.message);
        uploadBtn.disabled = false;
        uploadBtn.innerText = '开始上传';
    }
}

// 下载镜像
async function downloadImage(fullImageName) {
    if (!confirm(`确定要下载镜像 "${fullImageName}" 吗？`)) return;

    try {
        const response = await fetch(`/api/harbor/download-image?image=${encodeURIComponent(fullImageName)}`);

        if (response.ok) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${fullImageName.replace(/\//g, '_')}.tar`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
            alert('✅ 镜像下载已开始');
        } else {
            const error = await response.json();
            alert('❌ 下载失败: ' + (error.error || '未知错误'));
        }
    } catch(e) {
        alert('❌ 下载失败: ' + e.message);
    }
}




// 显示上传模态框
async function showUploadImageModal() {
    // 加载项目列表
    const projects = await fetchHarborProjects();
    const select = document.getElementById('uploadProject');
    if (projects && projects.length) {
        select.innerHTML = projects.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
    }
    document.getElementById('uploadImageName').value = '';
    document.getElementById('uploadImageTag').value = 'latest';
    document.getElementById('uploadTarFile').value = '';
    document.getElementById('uploadProgress').style.display = 'none';
    document.getElementById('uploadModal').style.display = 'flex';
}

function closeUploadImageModal() {
    document.getElementById('uploadModal').style.display = 'none';
}

// 上传镜像
async function uploadImage() {
    const project = document.getElementById('uploadProject').value;
    const imageName = document.getElementById('uploadImageName').value.trim();
    const imageTag = document.getElementById('uploadImageTag').value.trim();
    const fileInput = document.getElementById('uploadTarFile');
    const file = fileInput.files[0];

    if (!project) {
        alert('请选择项目');
        return;
    }
    if (!imageName) {
        alert('请输入镜像名称');
        return;
    }
    if (!imageTag) {
        alert('请输入镜像标签');
        return;
    }
    if (!file) {
        alert('请选择 tar 文件');
        return;
    }

    // 验证镜像名称格式
    if (!/^[a-z0-9_-]+$/.test(imageName)) {
        alert('镜像名称只能包含小写字母、数字、下划线、连字符');
        return;
    }

    const formData = new FormData();
    formData.append('project', project);
    formData.append('image_name', imageName);
    formData.append('image_tag', imageTag);
    formData.append('file', file);

    const uploadBtn = document.getElementById('uploadBtn');
    const progressDiv = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('uploadProgressFill');
    const statusDiv = document.getElementById('uploadStatus');

    uploadBtn.disabled = true;
    uploadBtn.innerText = '上传中...';
    progressDiv.style.display = 'block';

    try {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/harbor/upload-image');

        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressFill.style.width = percent + '%';
                statusDiv.innerText = `上传进度: ${percent}%`;
            }
        };

        xhr.onload = () => {
            if (xhr.status === 200) {
                const result = JSON.parse(xhr.responseText);
                if (result.success) {
                    alert('✅ 镜像上传成功！');
                    closeUploadImageModal();
                    loadHarborImages(); // 刷新列表
                } else {
                    alert('❌ 上传失败: ' + result.error);
                }
            } else {
                alert('❌ 上传失败: HTTP ' + xhr.status);
            }
            uploadBtn.disabled = false;
            uploadBtn.innerText = '开始上传';
        };

        xhr.onerror = () => {
            alert('❌ 上传失败: 网络错误');
            uploadBtn.disabled = false;
            uploadBtn.innerText = '开始上传';
        };

        xhr.send(formData);

    } catch(e) {
        alert('❌ 上传失败: ' + e.message);
        uploadBtn.disabled = false;
        uploadBtn.innerText = '开始上传';
    }
}

// 下载镜像
async function downloadImage(fullImageName) {
    if (!confirm(`确定要下载镜像 "${fullImageName}" 吗？`)) return;

    try {
        const response = await fetch(`/api/harbor/download-image?image=${encodeURIComponent(fullImageName)}`);

        if (response.ok) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${fullImageName.replace(/\//g, '_')}.tar`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
            alert('✅ 镜像下载已开始');
        } else {
            const error = await response.json();
            alert('❌ 下载失败: ' + (error.error || '未知错误'));
        }
    } catch(e) {
        alert('❌ 下载失败: ' + e.message);
    }
}

// ========== 健康检查缓存 ==========
let healthCache = {
    data: null,
    timestamp: 0,
    ttl: 30000 // 30秒内不重复请求
};

async function getHealthStatus() {
    const now = Date.now();
    if (healthCache.data && (now - healthCache.timestamp) < healthCache.ttl) {
        return healthCache.data;
    }

    try {
        const response = await fetch('/api/health');
        const data = await response.json();
        healthCache.data = data;
        healthCache.timestamp = now;
        return data;
    } catch(e) {
        console.error('健康检查失败:', e);
        return null;
    }
}

// 集群健康检查
async function checkClusterHealth() {
    try {
        const response = await fetch('/api/health/check');
        const data = await response.json();

        // etcd 状态
        const etcdStatusSpan = document.getElementById('etcdStatus');
        const etcdDetailSpan = document.getElementById('etcdDetail');
        if (data.etcd && data.etcd.healthy) {
            etcdStatusSpan.innerHTML = '✅ 健康';
            etcdStatusSpan.className = 'health-status healthy';
            etcdDetailSpan.innerHTML = `etcd 集群运行中: ${data.etcd.running_count} 个实例`;
        } else {
            etcdStatusSpan.innerHTML = '❌ 异常';
            etcdStatusSpan.className = 'health-status unhealthy';
            etcdDetailSpan.innerHTML = `etcd 集群可能有问题，运行实例: ${data.etcd?.running_count || 0}`;
        }

        // OOM 事件
        const oomStatusSpan = document.getElementById('oomStatus');
        const oomDetailSpan = document.getElementById('oomDetail');
        if (data.oom && data.oom.has_oom) {
            oomStatusSpan.innerHTML = '⚠️ 有 OOM';
            oomStatusSpan.className = 'health-status unhealthy';
            oomDetailSpan.innerHTML = `检测到 OOM 事件: ${data.oom.details.substring(0, 100)}...`;
        } else {
            oomStatusSpan.innerHTML = '✅ 无';
            oomStatusSpan.className = 'health-status healthy';
            oomDetailSpan.innerHTML = '最近无 OOM 事件';
        }

        // 慢节点
        const slowStatusSpan = document.getElementById('slowNodeStatus');
        const slowDetailSpan = document.getElementById('slowNodeDetail');
        if (data.slow_nodes && data.slow_nodes.count > 0) {
            slowStatusSpan.innerHTML = `⚠️ ${data.slow_nodes.count} 个`;
            slowStatusSpan.className = 'health-status unhealthy';
            let details = data.slow_nodes.details.map(n => `${n.name}: ${n.issue}`).join('; ');
            slowDetailSpan.innerHTML = details;
        } else {
            slowStatusSpan.innerHTML = '✅ 正常';
            slowStatusSpan.className = 'health-status healthy';
            slowDetailSpan.innerHTML = '所有节点负载正常';
        }

        // 网络异常
        const networkStatusSpan = document.getElementById('networkStatus');
        const networkDetailSpan = document.getElementById('networkDetail');
        if (data.network && data.network.has_issue) {
            networkStatusSpan.innerHTML = '⚠️ 异常';
            networkStatusSpan.className = 'health-status unhealthy';
            networkDetailSpan.innerHTML = `检测到网络问题: ${data.network.details.substring(0, 100)}...`;
        } else {
            networkStatusSpan.innerHTML = '✅ 正常';
            networkStatusSpan.className = 'health-status healthy';
            networkDetailSpan.innerHTML = '网络状态正常';
        }

    } catch(e) {
        console.error('集群健康检查失败:', e);
        // 设置默认状态
        ['etcdStatus', 'oomStatus', 'slowNodeStatus', 'networkStatus'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.innerHTML = '❌ 检查失败';
                el.className = 'health-status unhealthy';
            }
        });
    }
}





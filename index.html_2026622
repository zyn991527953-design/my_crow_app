// ========== 初始化 ==========
document.addEventListener('DOMContentLoaded', async () => {
    await loadConfig();
    loadSidebarState();
    loadCurrentUser();

    // ✅ 先加载仪表盘核心数据（关键）
    fetchDashboardData();

    // ✅ 健康检查延迟到 2 秒后执行，不阻塞首屏
    setTimeout(() => {
        checkAPIServerHealth();
        checkClusterHealth();
    }, 2000);

    // ✅ Harbor 等模块延迟到 3 秒后加载
    setTimeout(() => {
        loadHarborProjectsPage();
        initHarborImages();
    }, 3000);

    // ✅ 单个定时器管理所有刷新
    setInterval(() => {
        const activePage = document.querySelector('.page.active')?.id;
        if (activePage === 'dashboard') {
            fetchDashboardData();
            // 健康检查使用缓存，不频繁请求
            checkAPIServerHealth();
            checkClusterHealth();
        } else if (activePage === 'pods') {
            fetchPodsList();
        } else if (activePage === 'nodes') {
            fetchNodesList();
        }
    }, 30000);
});

// 注意：移除了原来的两个 setInterval，合并到上面的单个定时器中
// 之前的定时器：setInterval 30秒刷新仪表盘，setInterval 10秒检查健康
// 现在统一为30秒刷新一次
</script>
</body>
</html>

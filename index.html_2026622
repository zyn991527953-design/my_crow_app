async function fetchHarborImages(project = 'library') { try { return await (await fetch(`/api/harbor/projects/${project}/repositories`)).json(); } catch(e) { return []; } }
async function fetchHarborProjects() { try { return await (await fetch('/api/harbor/projects')).json(); } catch(e) { return []; } }
function renderHarborProjectsTable(projects) {
    const c = document.getElementById('harborProjectsTable');
    if (!projects || !projects.length) { c.innerHTML = '<div class="empty-state">暂无项目</div>'; return; }
    let h = '<table><thead><tr><th>项目名称</th><th>访问级别</th><th>镜像数量</th></tr></thead><tbody>';
    projects.forEach(p => { h += `<tr><td><strong>${p.name}</strong></td><td>${p.metadata?.public === 'true' ? '公开' : '私有'}</td><td>${p.repo_count || 0}</td></tr>`; });
    c.innerHTML = h + '</tbody></table>';
}




function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}




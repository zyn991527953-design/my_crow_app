function showLogs() { document.getElementById('logModal').style.display = 'flex'; loadPodListForLogs(); }


async function loadPodListForLogs() {
    const res = await fetch(`/api/pods?namespace=${currentNamespace}`);
    const data = await res.json();
    // 兼容两种格式
    let pods = data.items || data;
    if (Array.isArray(pods) && pods.length > 0 && !pods[0].metadata) {
        pods = pods.map(p => ({ metadata: { name: p.name, namespace: p.namespace } }));
    }
    const select = document.getElementById('logPodSelect');
    select.innerHTML = pods.map(p => `<option value="${p.metadata?.name || p.name}">${p.metadata?.name || p.name}</option>`).join('');
    if(select.options.length) fetchLogs();
}




            text-decoration: none;
            white-space: nowrap;
        }
        .quick-nav a:hover {
            background: #e6f7ff;
            color: #1890ff;
        }

        .loader {
            text-align: center;
            padding: 40px;
            color: #8c8c8c;
        }
        .spinner {
            width: 32px;
            height: 32px;
            border: 2px solid #f0f0f0;
            border-top-color: #1890ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 12px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>

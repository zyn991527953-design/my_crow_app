        .status-Succeeded { background: #e6f7ff; color: #1890ff; border: 1px solid #91d5ff; }

        .pod-name {
            font-family: monospace;
            font-size: 12px;
            color: #1890ff;
            cursor: pointer;
        }
        .pod-name:hover { text-decoration: underline; }

        /* 日志模态框 */
        .modal {
            display: none;

<script>
let currentDeployment = null;
let currentNamespace = 'cattle-system';
let currentDeploymentName = 'ccccccccccccccccccccc-k8s-workers-5';

function getUrlParams22() {
    const params = new URLSearchParams(window.location.search);
    currentNamespace = params.get('namespace') || 'cattle-system';
    currentDeploymentName = params.get('deployment') || 'ccccccccccccccccccccc-k8s-workers-5';
    document.getElementById('namespaceLink').innerHTML = `<a href="#">${currentNamespace}</a>`;
    document.getElementById('deployName').innerText = currentDeploymentName;
}


// 在 pods_manager.html 的 getUrlParams 函数中
function getUrlParams() {
    const params = new URLSearchParams(window.location.search);
    currentNamespace = params.get('namespace') || 'cattle-system';
    currentDeploymentName = params.get('deployment') || 'ccccccccccccccccccccc-k8s-workers-5';
    document.getElementById('namespaceLink').innerHTML = `<a href="#">${currentNamespace}</a>`;
    document.getElementById('deployName').innerText = currentDeploymentName;
    
    // 如果有 deployment 参数，自动加载
    if (params.get('deployment')) {
        loadDeploymentDetail();
    }
}



async function loadDeploymentDetail() {
    document.getElementById('podList').innerHTML = '<div class="loader"><div class="spinner"></div>加载中...</div>';

    const apiUrl = `/api/deployments/${currentNamespace}/${currentDeploymentName}`;
    const podsUrl = `/api/pods?namespace=${currentNamespace}`;
    const eventsUrl = `/api/events?namespace=${currentNamespace}`;
    const servicesUrl = `/api/services?namespace=${currentNamespace}`;
    const ingressesUrl = `/api/ingresses?namespace=${currentNamespace}`;

    try {
        const [deployRes, podsRes, eventsRes, servicesRes, ingressesRes] = await Promise.all([
            fetch(apiUrl).catch(e => ({ ok: false })),
            fetch(podsUrl).catch(e => ({ ok: false })),
            fetch(eventsUrl).catch(e => ({ ok: false })),
            fetch(servicesUrl).catch(e => ({ ok: false })),
            fetch(ingressesUrl).catch(e => ({ ok: false }))
        ]);

        if (deployRes.ok) currentDeployment = await deployRes.json();

        // 处理 Pods - 兼容两种格式
        let allPods = [];
        if (podsRes.ok) {
            const podsData = await podsRes.json();
            allPods = podsData.items || podsData;
            // 如果是数组且不是 K8s 原始格式，转换为统一格式
            if (Array.isArray(allPods) && allPods.length > 0 && !allPods[0].metadata) {
                allPods = allPods.map(p => ({
                    metadata: { name: p.name, namespace: p.namespace, creationTimestamp: new Date().toISOString() },
                    spec: { nodeName: p.node },
                    status: { phase: p.status, podIP: p.ip, containerStatuses: [{ restartCount: p.restarts || 0 }] }
                }));
            }
        }

        // 处理 Events
        let events = [];
        if (eventsRes.ok) {
            const eventsData = await eventsRes.json();
            events = eventsData.items || eventsData;
        }

        // 处理 Services
        let services = [];
        if (servicesRes.ok) {
            const servicesData = await servicesRes.json();
            services = servicesData.items || servicesData;
        }

        // 处理 Ingresses
        let ingresses = [];
        if (ingressesRes.ok) {
            const ingressesData = await ingressesRes.json();
            ingresses = ingressesData.items || ingressesData;
        }

        // 过滤 Deployment 相关事件
        const deploymentEvents = events.filter(e => {
            const involved = e.involvedObject || {};
            return involved.kind === 'Deployment' && involved.name === currentDeploymentName;
        });

        renderMetadata(currentDeployment);
        renderRuntime(currentDeployment);
        renderServices(services);
        renderIngresses(ingresses);
        renderPods(allPods);  // 使用修复后的 renderPods
        renderEvents(deploymentEvents);
        renderScaleInfo(currentDeployment);

    } catch(e) {
        console.error(e);
        document.getElementById('podList').innerHTML = '<div class="loader">加载失败: ' + e.message + '</div>';
    }
}







async function loadDeploymentDetail1() {
    document.getElementById('podList').innerHTML = '<div class="loader"><div class="spinner"></div>加载中...</div>';
    
    const apiUrl = `/api/deployments/${currentNamespace}/${currentDeploymentName}`;
    const podsUrl = `/api/pods?namespace=${currentNamespace}`;
    const eventsUrl = `/api/events?namespace=${currentNamespace}`;
    const servicesUrl = `/api/services?namespace=${currentNamespace}`;
    const ingressesUrl = `/api/ingresses?namespace=${currentNamespace}`;

    try {
        const [deployRes, podsRes, eventsRes, servicesRes, ingressesRes] = await Promise.all([
            fetch(apiUrl), fetch(podsUrl), fetch(eventsUrl), fetch(servicesUrl), fetch(ingressesUrl)
        ]);

        if (deployRes.ok) currentDeployment = await deployRes.json();
        
        const allPodsData = podsRes.ok ? await podsRes.json() : { items: [] };
        const allPods = allPodsData.items || allPodsData;
        
        const eventsData = eventsRes.ok ? await eventsRes.json() : { items: [] };
        const events = eventsData.items || eventsData;
        
        const servicesData = servicesRes.ok ? await servicesRes.json() : { items: [] };
        const services = servicesData.items || servicesData;
        
        const ingressesData = ingressesRes.ok ? await ingressesRes.json() : { items: [] };
        const ingresses = ingressesData.items || ingressesData;

        // 获取所有 Pod（不限制，展示该命名空间下所有 Pod）
        const allPodsList = allPods;
        
        // 过滤 Deployment 相关事件
        const deploymentEvents = events.filter(e => {
            const involved = e.involvedObject || {};
            return involved.kind === 'Deployment' && involved.name === currentDeploymentName;
        });

        renderMetadata(currentDeployment);
        renderRuntime(currentDeployment);
        renderServices(services);
        renderIngresses(ingresses);
        renderPods(allPodsList);
        renderEvents(deploymentEvents);
        renderScaleInfo(currentDeployment);

    } catch(e) {
        console.error(e);
        document.getElementById('podList').innerHTML = '<div class="loader">加载失败: ' + e.message + '</div>';
    }
}

function renderMetadata(deploy) {
    if (!deploy) return;
    const meta = deploy.metadata || {};
    document.getElementById('metaName').innerText = meta.name || '-';
    document.getElementById('metaNamespace').innerText = meta.namespace || '-';
    document.getElementById('metaUid').innerText = meta.uid || '-';
    document.getElementById('metaCreation').innerText = new Date(meta.creationTimestamp).toLocaleString() || '-';
    
    const labels = meta.labels || {};
    document.getElementById('metaLabels').innerHTML = Object.entries(labels).map(([k,v]) => `<span class="label-tag"><span class="key">${k}</span>: ${v}</span>`).join('') || '-';
    
    const annotations = meta.annotations || {};
    document.getElementById('metaAnnotations').innerHTML = Object.entries(annotations).slice(0,5).map(([k,v]) => `<span class="label-tag">${k}=${v.substring(0,50)}</span>`).join('') || '-';
}

function renderRuntime(deploy) {
    if (!deploy) return;
    const container = deploy.spec?.template?.spec?.containers?.[0] || {};
    const resources = container.resources || {};
    const cpuReq = resources.requests?.cpu || '-';
    const cpuLim = resources.limits?.cpu || '-';
    const memReq = resources.requests?.memory || '-';
    const memLim = resources.limits?.memory || '-';
    
    document.getElementById('runtimeCpu').innerHTML = `${cpuReq} / ${cpuLim}`;
    document.getElementById('runtimeMemory').innerHTML = `${memReq} / ${memLim}`;
    document.getElementById('runtimeImage').innerText = container.image || '-';
    document.getElementById('runtimePullPolicy').innerText = container.imagePullPolicy || 'Always';
    document.getElementById('runtimeCommand').innerText = (container.command || []).join(' ') || '-';
    document.getElementById('runtimeEnv').innerHTML = (container.env || []).slice(0,5).map(e => `<span class="label-tag">${e.name}=${e.value || '...'}</span>`).join('') || '-';
}

function renderServices(services) {
    const container = document.getElementById('serviceList');
    if (!services.length) {
        container.innerHTML = '<div style="color:#8c8c8c;">暂无服务</div>';
        return;
    }
    container.innerHTML = services.map(svc => {
        const meta = svc.metadata || {};
        const spec = svc.spec || {};
        return `
            <div style="margin-bottom: 12px; padding: 12px; background: #fafafa; border-radius: 4px;">
                <div><strong>${meta.name}</strong> <span style="color:#8c8c8c;">(${spec.type || 'ClusterIP'})</span></div>
                <div style="font-size:12px; color:#8c8c8c; margin-top:8px;">
                    ClusterIP: ${spec.clusterIP || '-'} | 
                    端口: ${(spec.ports || []).map(p => `${p.port}/${p.protocol}→${p.targetPort}`).join(', ')}
                </div>
            </div>
        `;
    }).join('');
}

function renderIngresses(ingresses) {
    const container = document.getElementById('routeList');
    if (!ingresses.length) {
        container.innerHTML = '<div style="color:#8c8c8c;">暂无 Ingress</div>';
        return;
    }
    container.innerHTML = ingresses.map(ing => {
        const meta = ing.metadata || {};
        const spec = ing.spec || {};
        return `
            <div style="margin-bottom: 12px; padding: 12px; background: #fafafa; border-radius: 4px;">
                <div><strong>${meta.name}</strong></div>
                ${(spec.rules || []).map(rule => `
                    <div style="font-size:12px; margin-top:8px;">
                        🚪 ${rule.host || '*'}
                        ${(rule.http?.paths || []).map(p => ` → ${p.path || '/'} → ${p.backend?.service?.name}:${p.backend?.service?.port?.number}`).join('')}
                    </div>
                `).join('')}
            </div>
        `;
    }).join('');
}


function renderPods(pods) {
    const container = document.getElementById('podList');
    if (!pods || !pods.length) {
        container.innerHTML = '<div style="color:#8c8c8c;">暂无 Pod</div>';
        return;
    }
    
    container.innerHTML = `
        <table class="pod-table">
            <thead>
                <tr><th>名称</th><th>节点</th><th>IP</th><th>状态</th><th>重启次数</th><th>年龄</th><th>操作</th></tr>
            </thead>
            <tbody>
                ${pods.map(pod => {
                    // 兼容两种数据格式
                    // 格式1: K8s 原始格式 (metadata.name, spec.nodeName, status.phase)
                    // 格式2: 简化格式 (name, node, status, ip, restarts)
                    
                    let name = pod.metadata?.name || pod.name || '-';
                    let namespace = pod.metadata?.namespace || pod.namespace || '-';
                    let nodeName = pod.spec?.nodeName || pod.node || '-';
                    let podIP = pod.status?.podIP || pod.ip || '-';
                    let phase = pod.status?.phase || pod.status || 'Unknown';
                    let restartCount = 0;
                    
                    // 获取重启次数
                    if (pod.status?.containerStatuses?.[0]?.restartCount !== undefined) {
                        restartCount = pod.status.containerStatuses[0].restartCount;
                    } else if (pod.restarts !== undefined) {
                        restartCount = pod.restarts;
                    }
                    
                    // 计算年龄
                    let age = '-';
                    if (pod.metadata?.creationTimestamp) {
                        const created = new Date(pod.metadata.creationTimestamp);
                        age = Math.floor((Date.now() - created) / 1000 / 60) + 'm';
                    } else if (pod.age) {
                        age = pod.age;
                    }
                    
                    // 确定状态样式
                    const statusClass = phase === 'Running' ? 'status-Running' : 
                                      (phase === 'Pending' ? 'status-Pending' : 
                                      (phase === 'Failed' ? 'status-Failed' : 'status-Succeeded'));
                    
                    return `
                        <tr>
                            <td><span class="pod-name" onclick="showPodLogs('${namespace}', '${name}')">${name}</span></td>
                            <td>${nodeName}</td>
                            <td>${podIP}</td>
                            <td><span class="status-badge ${statusClass}">${phase}</span></td>
                            <td>${restartCount}</td>
                            <td>${age}</td>
                            <td><button class="btn btn-outline" style="padding:2px 12px;" onclick="showPodLogs('${namespace}', '${name}')">日志</button></td>
                        </tr>
                    `;
                }).join('')}
            </tbody>
        </table>
    `;
}




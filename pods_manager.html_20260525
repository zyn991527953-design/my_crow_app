            color: #8c8c8c;
        }
        .modal-close:hover { color: #ff4d4f; }

        /* 右侧快速导航 */
        .quick-nav {
            position: fixed;
            right: 24px;
            top: 50%;
            transform: translateY(-50%);
            background: white;
            border-radius: 8px;
            padding: 8px 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            font-size: 12px;
            z-index: 90;
            border: 1px solid #e4e7ed;
        }
        .quick-nav a {

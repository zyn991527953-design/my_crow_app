function renderScaleInfo(deploy) {
    if (!deploy) return;
    document.getElementById('desiredReplicas').innerText = deploy.spec?.replicas || 0;
    document.getElementById('currentReplicas').innerText = deploy.status?.replicas || 0;
    document.getElementById('readyReplicas').innerText = deploy.status?.readyReplicas || 0;
    document.getElementById('availableReplicas').innerText = deploy.status?.availableReplicas || 0;
}


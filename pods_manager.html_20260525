async function showPodLogs(namespace, podName) {
    currentNamespace = namespace;
    document.getElementById('logModal').style.display = 'flex';
    const select = document.getElementById('logPodSelect');
    select.innerHTML = `<option value="${podName}">${podName}</option>`;
    await fetchLogs(podName);
}

async function fetchLogs() {
    const pod = document.getElementById('logPodSelect').value;
    if(!pod) return;
    const previous = document.getElementById('logPrevious').checked;
    const res = await fetch(`/api/pods/${currentNamespace}/${pod}/logs?previous=${previous}`);
    const logs = await res.text();
    document.getElementById('logContainer').innerHTML = logs || '(无日志)';
}



    content.innerHTML = '<div class="loader">加载中...</div>';
    try {
        const res = await fetch(`/api/pods/${currentNamespace}/${currentFileBrowserPod}/files/list?path=${encodeURIComponent(path)}`);
        const files = await res.json();

        if (files.error) {
            content.innerHTML = `<div style="color:#ff4d4f;">错误: ${files.error}</div>`;
            return;
        }

        content.innerHTML = `
            ${path !== '/' ? `<div class="file-item dir" onclick="loadDirectory('${getParentPath(path)}')">📁 .. (上级目录)</div>` : ''}
            ${files.map(file => `
                <div class="file-item ${file.isDir ? 'dir' : 'file'}" onclick="${file.isDir ? `loadDirectory('${path === '/' ? '/' + file.name : path + '/' + file.name}')` : `viewFile('${path === '/' ? '/' + file.name : path + '/' + file.name}')`}">
                    ${file.isDir ? '📁' : '📄'} ${file.name}
                </div>
            `).join('')}
        `;
    } catch(e) {
        content.innerHTML = `<div style="color:#ff4d4f;">加载失败: ${e.message}</div>`;
    }
}

function getParentPath(path) {
    if (path === '/') return '/';
    const parts = path.split('/');
    parts.pop();
    return parts.join('/') || '/';
}

async function viewFile(filePath) {
    const content = document.getElementById('fileBrowserContent');
    content.innerHTML = '<div class="loader">加载中...</div>';
    try {
        const res = await fetch(`/api/pods/${currentNamespace}/${currentFileBrowserPod}/files/view?path=${encodeURIComponent(filePath)}`);
        const data = await res.text();
        content.innerHTML = `<pre style="background:#1e1e1e; color:#d4d4d4; padding:12px; border-radius:4px; overflow-x:auto; font-size:12px;">${escapeHtml(data)}</pre>`;
    } catch(e) {
        content.innerHTML = `<div style="color:#ff4d4f;">读取文件失败: ${e.message}</div>`;
    }
}




function formatFileSize(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

// ========== 显示 Pod 日志（从表格点击）==========
async function showPodLogs(namespace, podName) {
    currentNamespace = namespace;
    document.getElementById('logModal').style.display = 'flex';
    const select = document.getElementById('logPodSelect');
    select.innerHTML = `<option value="${podName}">${podName}</option>`;
    await fetchLogs();
}


let term = null;
let ws = null;

async function openTerminal(namespace, podName, containerName) {
    document.getElementById('terminalModal').style.display = 'flex';
    document.getElementById('terminalPodName').innerText = `${podName} (${containerName || 'app'})`;

    const terminalContainer = document.getElementById('terminalOutput');
    terminalContainer.innerHTML = '';

    // 初始化 xterm.js
    if (typeof Terminal === 'undefined') {
        // 如果 xterm 未加载，动态加载
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/xterm/lib/xterm.js';
        script.onload = () => {
            initTerminal(namespace, podName, containerName);
        };
        document.head.appendChild(script);

        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/xterm/css/xterm.css';
        document.head.appendChild(link);
    } else {
        initTerminal(namespace, podName, containerName);
    }
}

function initTerminal(namespace, podName, containerName) {
    term = new Terminal({
        cursorBlink: true,
        fontSize: 14,
        fontFamily: 'Menlo, Monaco, "Courier New", monospace',
        theme: {
            background: '#1e1e1e',
            foreground: '#d4d4d4',
            cursor: '#d4d4d4'
        }
    });

    const terminalContainer = document.getElementById('terminalOutput');
    term.open(terminalContainer);

    // 连接 WebSocket
    const wsUrl = `ws://192.168.138.139:8082/ws?namespace=${namespace}&pod=${podName}&container=${containerName || 'app'}`;
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
        term.write('\r\n\x1b[32m✅ 已连接到容器\x1b[0m\r\n');
        term.write('\x1b[36m# \x1b[0m');
    };

    ws.onmessage = (event) => {
        const data = JSON.parse(event.data);
        if (data.operation === 'stdout') {
            term.write(data.data);
        }
    };

    ws.onerror = (error) => {
        term.write('\r\n\x1b[31m❌ WebSocket 连接错误\x1b[0m\r\n');
    };

    ws.onclose = () => {
        term.write('\r\n\x1b[33m⚠️ 连接已关闭\x1b[0m\r\n');
    };

    term.onData((data) => {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ operation: 'stdin', data: data }));
        }
    });

    // 终端大小调整
    window.addEventListener('resize', () => {
        if (term) {
            term.resize(term.cols, term.rows);
        }
    });
}

function closeTerminalModal() {
    if (ws) {
        ws.close();
        ws = null;
    }
    if (term) {
        term.dispose();
        term = null;
    }
    document.getElementById('terminalModal').style.display = 'none';
}





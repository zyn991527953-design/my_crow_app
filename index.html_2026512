function showIframePage(url, title) {
    // 删除旧的 iframe
    let oldIframe = document.getElementById('iframeContainer');
    if (oldIframe) {
        oldIframe.remove();
    }

    // 隐藏普通页面
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));

    // 创建 iframe 容器
    let iframeContainer = document.createElement('div');
    iframeContainer.id = 'iframeContainer';
    iframeContainer.style.cssText = 'width:100%; height:calc(100vh - 100px); background:white; border-radius:8px; overflow:hidden;';
    iframeContainer.innerHTML = `
        <div class="page-header" style="margin-bottom:0;">
            <h1>${title}</h1>
            <button class="refresh-btn" onclick="document.getElementById('iframeContainer').querySelector('iframe').contentWindow.location.reload()">
                <span>🔄</span><span>刷新</span>
            </button>
        </div>
        <iframe src="${url}" style="width:100%; height:calc(100% - 60px); border:none;"></iframe>
    `;

    // 清空 main-content 并添加 iframe
    const mainContent = document.querySelector('.main-content');
    // 保留 page-header 标题区域，但替换内容
    const oldHeader = mainContent.querySelector('.page-header');
    if (oldHeader) {
        // 只替换 h1 和刷新按钮
        const newHeader = iframeContainer.querySelector('.page-header');
        oldHeader.innerHTML = newHeader.innerHTML;
    }

    // 移除旧的 iframe 容器内容区
    const oldContent = mainContent.querySelector('#iframeContent');
    if (oldContent) oldContent.remove();

    // 创建内容区
    const contentDiv = document.createElement('div');
    contentDiv.id = 'iframeContent';
    contentDiv.style.cssText = 'margin-top:20px; height:calc(100vh - 160px);';
    contentDiv.appendChild(iframeContainer.querySelector('iframe'));
    mainContent.appendChild(contentDiv);

    document.getElementById('pageTitle').innerText = title;
}




function showIframePage22(url, title) {
    // 先删除已有的 iframe 容器
    let oldIframe = document.getElementById('iframeContainer');
    if (oldIframe) {
        oldIframe.remove();
    }
    
    // 隐藏所有普通页面
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    
    // 创建新的 iframe 容器
    let iframeContainer = document.createElement('div');
    iframeContainer.id = 'iframeContainer';
    iframeContainer.innerHTML = `
        <div class="page-header">
            <h1>${title}</h1>
            <button class="refresh-btn" onclick="document.querySelector('#iframeContainer iframe').contentWindow.location.reload()">
                <span>🔄</span><span>刷新</span>
            </button>
        </div>
        <iframe src="${url}" style="width:100%; height:calc(100vh - 120px); border:none; border-radius:8px; background:white;"></iframe>
    `;
    document.querySelector('.main-content').appendChild(iframeContainer);
    
    document.getElementById('pageTitle').innerText = title;
}



function openModalPage(url, title) {
    // 创建遮罩层
    let modal = document.getElementById('pageModal');
    if (!modal) {
        modal = document.createElement('div');
        modal.id = 'pageModal';
        modal.style.cssText = 'position:fixed; top:0; left:260px; right:0; bottom:0; background:white; z-index:1000; display:none; flex-direction:column;';
        modal.innerHTML = `
            <div style="padding:15px 20px; background:#1a1a2e; color:white; display:flex; justify-content:space-between; align-items:center;">
                <h3 style="margin:0;" id="modalTitle">页面</h3>
                <button onclick="closeModalPage()" style="background:none; border:none; color:white; font-size:24px; cursor:pointer;">✕</button>
            </div>
            <iframe id="modalIframe" style="flex:1; border:none; width:100%;"></iframe>
        `;
        document.body.appendChild(modal);
    }
    
    document.getElementById('modalTitle').innerText = title;
    document.getElementById('modalIframe').src = url;
    modal.style.display = 'flex';
}

function closeModalPage() {
    const modal = document.getElementById('pageModal');
    if (modal) {
        modal.style.display = 'none';
        document.getElementById('modalIframe').src = '';
    }
}


function openPageInIframe(url, title) {
    // 隐藏所有普通页面
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    
    // 获取或创建 iframe 容器
    let iframeContainer = document.getElementById('iframeContainer');
    if (!iframeContainer) {
        iframeContainer = document.createElement('div');
        iframeContainer.id = 'iframeContainer';
        iframeContainer.style.cssText = 'width:100%; height:calc(100vh - 120px); background:white; border-radius:8px; overflow:hidden;';
        document.querySelector('.main-content').appendChild(iframeContainer);
    }
    
    iframeContainer.innerHTML = `
        <iframe src="${url}" style="width:100%; height:100%; border:none;"></iframe>
    `;
    document.getElementById('pageTitle').innerText = title;
}

function closeIframe() {
    let iframeContainer = document.getElementById('iframeContainer');
    if (iframeContainer) {
        iframeContainer.remove();
    }
    switchPage('dashboard');
}




// ========== 初始化 ==========
document.addEventListener('DOMContentLoaded', async () => {
    await loadConfig();
    fetchDashboardData();
    setInterval(() => { if(currentPage==='dashboard')fetchDashboardData(); else if(currentPage==='pods')fetchPodsList(); else if(currentPage==='nodes')fetchNodesList(); }, 30000);
});
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    <title>☸️ K8s 集群管理面板</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f0f2f5; display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); color: #fff; display: flex; flex-direction: column; position: fixed; height: 100vh; left: 0; top: 0; overflow-y: auto; box-shadow: 2px 0 12px rgba(0,0,0,0.1); }
        .sidebar-header { padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-header h2 { font-size: 20px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .sidebar-menu { flex: 1; padding: 20px 0; }
        .menu-item { padding: 12px 20px; margin: 4px 12px; border-radius: 8px; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.7); }
        .menu-item:hover { background: rgba(255,255,255,0.1); color: #fff; }
        .menu-item.active { background: #4a90e2; color: #fff; }
        .submenu { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; background: rgba(0,0,0,0.2); margin: 0 12px; border-radius: 8px; }
        .submenu.active { max-height: 500px; }
        .submenu-item { padding: 10px 20px 10px 52px; cursor: pointer; color: rgba(255,255,255,0.6); transition: all 0.2s; font-size: 14px; }
        .submenu-item:hover { background: rgba(255,255,255,0.05); color: #fff; }
        .submenu-item.active { color: #4a90e2; background: rgba(74,144,226,0.1); }
        .menu-item .arrow { margin-left: auto; font-size: 12px; transition: transform 0.3s; }
        .menu-item.expanded .arrow { transform: rotate(90deg); }
        .main-content { flex: 1; margin-left: 260px; padding: 24px 32px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .page-header h1 { color: #1a1a2e; font-size: 28px; font-weight: 600; }
        .refresh-btn { background: #4a90e2; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; display: flex; align-items: center; gap: 8px; transition: all 0.2s; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
        .stat-card { background: white; padding: 24px 20px; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: all 0.3s; border: 1px solid #eee; }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
        .stat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .stat-header span { color: #666; font-size: 14px; font-weight: 500; }
        .stat-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .stat-icon.nodes { background: #e3f2fd; color: #1976d2; } .stat-icon.pods { background: #e8f5e9; color: #388e3c; }
        .stat-icon.running { background: #fff3e0; color: #f57c00; } .stat-icon.deploy { background: #f3e5f5; color: #7b1fa2; }
        .stat-number { font-size: 36px; font-weight: 700; color: #1a1a2e; }
        .content-section { background: white; border-radius: 16px; padding: 24px; margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid #eee; }
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .section-header h2 { color: #1a1a2e; font-size: 18px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .badge { background: #e8f5e9; color: #2e7d32; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 500; }
        .table-container { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 14px 12px; background: #f8f9fa; color: #555; font-weight: 600; font-size: 13px; border-bottom: 2px solid #e0e0e0; }
        td { padding: 14px 12px; border-bottom: 1px solid #eee; color: #333; font-size: 14px; }
        tr:hover { background: #f8f9fa; }
        .status-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
        .status-ready, .status-running, .status-active { background: #e8f5e9; color: #2e7d32; }
        .status-not-ready, .status-pending, .status-terminating { background: #fff3e0; color: #e65100; }
        .status-failed, .status-warning { background: #ffebee; color: #c62828; }
        .namespace-tag { background: #e3f2fd; color: #1565c0; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
        .empty-state { text-align: center; padding: 40px; color: #999; }
        .page { display: none; } .page.active { display: block; }
        .footer-note { text-align: center; padding: 20px; color: #999; font-size: 13px; border-top: 1px solid #eee; margin-top: 20px; }
    </style>
</head>
<body>
<div class="sidebar">
    <div class="sidebar-header"><h2><span>☸️</span><span>K8s Manager</span></h2></div>
    <div class="sidebar-menu">
        <div class="menu-item active" onclick="switchPage('dashboard')"><span>📊</span><span>仪表盘</span></div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>📦</span><span>工作负载</span><span class="arrow">▶</span></div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('pods'); setActiveSubmenu(this)">Pods</div>
	    <div class="submenu-item" onclick="openPageInIframe('/pods_manager.html', 'Pod 管理(高级)')">Pod 管理(高级)</div>
            <div class="submenu-item" onclick="switchPage('deployments'); setActiveSubmenu(this)">Deployments</div>
            <div class="submenu-item" onclick="switchPage('services'); setActiveSubmenu(this)">Services</div>
            <div class="submenu-item" onclick="switchPage('configmaps'); setActiveSubmenu(this)">ConfigMaps</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>📊</span><span>数据集管理</span><span class="arrow">▶</span></div>
        <div class="submenu">
            <div class="submenu-item" onclick="window.open(getConfig('Label Studio'), '_blank')">Label Studio</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>🚀</span><span>集群调度</span><span class="arrow">▶</span></div>
        <div class="submenu">
	    
	    <div class="submenu-item" onclick="switchPage('scheduler'); setActiveSubmenu(this)">容器调度（简单）</div>
	    <div class="submenu-item" onclick="switchPage('scheduler_advanced'); setActiveSubmenu(this)">容器调度（增强版）</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>🐳</span><span>镜像仓库</span><span class="arrow">▶</span></div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('harborImages'); setActiveSubmenu(this)">Harbor 镜像</div>
            <div class="submenu-item" onclick="switchPage('harborProjects'); setActiveSubmenu(this)">Harbor 项目</div>
            <div class="submenu-item" onclick="window.open(getConfig('Harbor'), '_blank')">Harbor 仓库</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>📈</span><span>系统监控</span><span class="arrow">▶</span></div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('grafana'); setActiveSubmenu(this)">Grafana</div>
            <div class="submenu-item" onclick="window.open(getConfig('Prometheus'), '_blank')">Prometheus</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>⚙️</span><span>集群自动化</span><span class="arrow">▶</span></div>
        <div class="submenu">
            <div class="submenu-item" onclick="switchPage('jenkins'); setActiveSubmenu(this)">Jenkins CICD</div>
            <div class="submenu-item" onclick="switchPage('pytestweb'); setActiveSubmenu(this)">PytestWEB</div>
            <div class="submenu-item" onclick="switchPage('autotest'); setActiveSubmenu(this)">自动化测试</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>💾</span><span>集群存储</span><span class="arrow">▶</span></div>
        <div class="submenu">
	    <div class="submenu-item" onclick="switchPage('ceph_storage'); setActiveSubmenu(this)">Ceph 网盘</div>
            <div class="submenu-item" onclick="switchPage('cephflask'); setActiveSubmenu(this)">Ceph 管理</div>
            <div class="submenu-item" onclick="window.open(getConfig('Ceph Web'), '_blank')">Ceph 网页</div>
        </div>
        <div class="menu-item" onclick="toggleSubmenu(this)"><span>🖥️</span><span>集群管理</span><span class="arrow">▶</span></div>
        <div class="submenu">
            <div class="submenu-item" onclick="window.open(getConfig('Kuboard'), '_blank')">Kuboard</div>
            <div class="submenu-item" onclick="switchPage('nodes'); setActiveSubmenu(this)">节点</div>
            <div class="submenu-item" onclick="switchPage('namespaces'); setActiveSubmenu(this)">命名空间</div>
            <div class="submenu-item" onclick="switchPage('events'); setActiveSubmenu(this)">事件</div>
            <div class="submenu-item" onclick="switchPage('config'); setActiveSubmenu(this)">组件配置</div>
        </div>
    </div>
</div>

<div class="main-content">
    <div class="page-header"><h1 id="pageTitle">📊 仪表盘</h1><button class="refresh-btn" onclick="refreshCurrentPage()"><span>🔄</span><span>刷新数据</span></button></div>
    <div id="dashboard" class="page active">
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-header"><span>节点总数</span><div class="stat-icon nodes">🖥️</div></div><div class="stat-number" id="statNodes">-</div></div>
            <div class="stat-card"><div class="stat-header"><span>Pod 总数</span><div class="stat-icon pods">📦</div></div><div class="stat-number" id="statPods">-</div></div>
            <div class="stat-card"><div class="stat-header"><span>运行中 Pod</span><div class="stat-icon running">✅</div></div><div class="stat-number" id="statRunning">-</div></div>
            <div class="stat-card"><div class="stat-header"><span>Deployments</span><div class="stat-icon deploy">🚀</div></div><div class="stat-number" id="statDeploy">-</div></div>
        </div>
        <div class="content-section"><div class="section-header"><h2><span>🖥️</span> 节点状态</h2><span class="badge" id="nodeReadyCount">-</span></div><div class="table-container" id="dashboardNodes"></div></div>
        <div class="content-section"><div class="section-header"><h2><span>📦</span> 最近 Pods</h2><span class="badge" id="podTotalCount">-</span></div><div class="table-container" id="dashboardPods"></div></div>
    </div>
    <div id="pods" class="page"><div class="content-section"><div class="section-header"><h2><span>📦</span> 所有 Pods</h2><span class="badge" id="podListCount">-</span></div><div class="table-container" id="podsTable"></div></div></div>
    <div id="nodes" class="page"><div class="content-section"><div class="section-header"><h2><span>🖥️</span> 所有节点</h2><span class="badge" id="nodeListCount">-</span></div><div class="table-container" id="nodesTable"></div></div></div>
    <div id="deployments" class="page"><div class="content-section"><div class="section-header"><h2><span>🚀</span> Deployments</h2><span class="badge" id="deployListCount">-</span></div><div class="table-container" id="deploymentsTable"></div></div></div>
    <div id="services" class="page"><div class="content-section"><div class="section-header"><h2><span>🔌</span> Services</h2><span class="badge" id="serviceListCount">-</span></div><div class="table-container" id="servicesTable"></div></div></div>
    <div id="configmaps" class="page"><div class="content-section"><div class="section-header"><h2><span>📋</span> ConfigMaps</h2><span class="badge" id="cmListCount">-</span></div><div class="table-container" id="configmapsTable"></div></div></div>
    <div id="namespaces" class="page"><div class="content-section"><div class="section-header"><h2><span>📁</span> 命名空间</h2><span class="badge" id="nsListCount">-</span></div><div class="table-container" id="namespacesTable"></div></div></div>
    <div id="events" class="page"><div class="content-section"><div class="section-header"><h2><span>📅</span> 事件</h2><span class="badge" id="eventListCount">-</span></div><div class="table-container" id="eventsTable"></div></div></div>
    <div id="scheduler" class="page">
        <div class="content-section"><div class="section-header"><h2><span>🚀</span> 容器调度</h2></div>
            <div class="scheduler-form">
		 <h3>选择镜像</h3>
<input type="text" id="imageSearch" placeholder="🔍 搜索镜像..." oninput="filterImages()" onfocus="showImageList()" autocomplete="off" style="width:100%;padding:10px;margin-bottom:5px;border-radius:8px;border:1px solid #ddd;">
<div id="imageDropdown" style="max-height:250px;overflow-y:auto;border:1px solid #ddd;border-radius:8px;display:none;background:white;"></div>
<input type="hidden" id="imageSelect"> 
                <h3>资源配置</h3>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:15px;">
                    <div><label>CPU 核心数</label><input type="number" id="cpuCores" value="0.1" min="0.1" step="0.1" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd;"></div>
                    <div><label>内存 (MB)</label><input type="number" id="memoryMB" value="8" min="8" step="8" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd;"></div>
                </div>
                <h3>选择节点</h3><select id="nodeSelect" style="width:100%;padding:10px;margin-bottom:15px;border-radius:8px;border:1px solid #ddd;"><option value="">-- 自动调度 --</option></select>
                <button onclick="createDeployment()" style="padding:12px 24px;background:#4a90e2;color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;">🚀 部署容器</button>
            </div>
        </div>
    </div>
    <div id="harborImages" class="page">
        <div class="content-section"><div class="section-header"><h2><span>🐳</span> Harbor 镜像列表</h2><span class="badge" id="harborImageCount">-</span></div>
            <div style="margin-bottom:15px;"><select id="harborProjectSelect" onchange="loadHarborImages()" style="padding:10px;border-radius:8px;border:1px solid #ddd;"><option value="library">library</option></select><button onclick="refreshHarborImages()" style="margin-left:10px;padding:10px 20px;background:#4a90e2;color:white;border:none;border-radius:8px;">🔄 刷新</button></div>
            <div class="table-container" id="harborImagesTable"></div>
        </div>
    </div>
    <div id="harborProjects" class="page"><div class="content-section"><div class="section-header"><h2><span>📁</span> Harbor 项目</h2></div><div class="table-container" id="harborProjectsTable"></div></div></div>
    <div id="grafana" class="page"></div>
    <div id="jenkins" class="page"><iframe src="/jenkins/configure" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe></div>
    <div id="pytestweb" class="page"><iframe src="/pytestweb/reports" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe></div>
    <div id="autotest" class="page"><iframe src="about:blank" id="autotestIframe" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe></div>
    <div id="cephflask" class="page"><iframe id="cephflaskIframe" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe></div>
    <div id="scheduler_advanced" class="page"><iframe src="/scheduler_advanced.html" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe></div>
    <div id="ceph_storage" class="page"><iframe src="/ceph_storage.html" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe></div>
    <div id="config" class="page">
        <div class="content-section"><div class="section-header"><h2><span>⚙️</span> 组件配置</h2></div>
            <table id="configTable"><thead><tr><th>组件名称</th><th>地址</th><th>端口</th><th>操作</th></tr></thead><tbody id="configTableBody"></tbody></table>
            <button onclick="addConfigRow()" style="margin-top:15px;padding:10px 20px;background:#4a90e2;color:white;border:none;border-radius:8px;cursor:pointer;">➕ 添加组件</button>
            <button onclick="saveConfig()" style="margin-top:15px;margin-left:10px;padding:10px 20px;background:#67c23a;color:white;border:none;border-radius:8px;cursor:pointer;">💾 保存配置</button>
        </div>
    </div>
    <div class="footer-note">⚠️ 只读模式 | 数据每30秒自动刷新</div>
</div>

<script>
// ========== 全局变量 ==========
const API_BASE = '/api';
let currentPage = 'dashboard';
let componentConfig = [];

// ========== 配置管理函数 ==========
async function loadConfig() {
    try {
        const res = await fetch('/api/component-config');
        componentConfig = await res.json();
    } catch(e) { console.error('加载配置失败', e); }
}
function getConfig1(name) {
    const c = componentConfig.find(i => i.name === name);
    return c ? `http://${c.host}:${c.port}${c.path || '/'}` : '#';
}

function getConfig(name) {
    const c = componentConfig.find(i => i.name === name);
    if (!c) return '#';
    const host = c.host.replace(/^https?:\/\//, '');
    const protocol = c.host.startsWith('https') ? 'https' : 'http';
    return `${protocol}://${host}:${c.port}${c.path || '/'}`;
}
async function saveConfig() {
    try {
        await fetch('/api/component-config', { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(componentConfig) });
        alert('✅ 配置已保存到数据库');
    } catch(e) { alert('❌ 保存失败'); }
}
function renderConfigTable() {
    const tbody = document.getElementById('configTableBody');
    if (!tbody) return;
    tbody.innerHTML = componentConfig.map((c, i) => `
        <tr>
            <td><input value="${c.name||''}" onchange="componentConfig[${i}].name=this.value" style="width:120px;padding:6px;border-radius:6px;border:1px solid #ddd;"></td>
            <td><input value="${c.host||''}" onchange="componentConfig[${i}].host=this.value" style="width:140px;padding:6px;border-radius:6px;border:1px solid #ddd;"></td>
            <td><input value="${c.port||''}" onchange="componentConfig[${i}].port=this.value" style="width:80px;padding:6px;border-radius:6px;border:1px solid #ddd;"></td>
            <td><button onclick="componentConfig.splice(${i},1);renderConfigTable()" style="padding:4px 10px;background:#f56c6c;color:white;border:none;border-radius:4px;cursor:pointer;">删除</button></td>
        </tr>`).join('');
}
function addConfigRow() { componentConfig.push({name:'New',host:'192.168.138.139',port:'80',path:'/'}); renderConfigTable(); }

// ========== 菜单交互 ==========
function toggleSubmenu(el) { el.classList.toggle('expanded'); el.nextElementSibling.classList.toggle('active'); }
function setActiveSubmenu(el) { el.parentElement.querySelectorAll('.submenu-item').forEach(i => i.classList.remove('active')); el.classList.add('active'); }

// ========== 页面切换 ==========
function switchPage(pageId) {


    // ===== 新增：销毁 iframe 容器 =====
    let iframeContainer = document.getElementById('iframeContainer');
    if (iframeContainer) {
        iframeContainer.remove();  // 彻底删除，而不是隐藏
    }
    // ================================

    if (currentPage === 'grafana' && pageId !== 'grafana') { document.getElementById('grafana').innerHTML = ''; }
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById(pageId).classList.add('active');
    currentPage = pageId;

    const titles = { dashboard:'📊 仪表盘', pods:'📦 Pods', nodes:'🖥️ 节点', deployments:'🚀 Deployments', services:'🔌 Services', configmaps:'📋 ConfigMaps', namespaces:'📁 命名空间', events:'📅 事件', scheduler:'🚀 容器调度', harborImages:'🐳 Harbor 镜像', harborProjects:'📁 Harbor 项目', grafana:'📈 Grafana 监控', prometheus:'🔥 Prometheus', jenkins:'⚙️ Jenkins CICD', pytestweb:'🧪 PytestWEB', autotest:'🧪 自动化测试', cephflask:'💾 Ceph 管理', config:'⚙️ 组件配置', scheduler_advanced:'🚀 容器调度（增强版）', ceph_storage:'💾 Ceph 网盘' };
    document.getElementById('pageTitle').innerText = titles[pageId] || pageId;

    const loaders = {
        dashboard: fetchDashboardData, pods: fetchPodsList, nodes: fetchNodesList, deployments: fetchDeploymentsList,
        services: fetchServicesList, configmaps: fetchConfigMapsList, namespaces: fetchNamespacesList, events: fetchEventsList,
        scheduler: loadSchedulerPage, harborImages: loadHarborImages, harborProjects: loadHarborProjectsPage,
        config: renderConfigTable, autotest: autoLoginAutotest
    };
    if (loaders[pageId]) loaders[pageId]();

    if (pageId === 'grafana') {
        const c = document.getElementById('grafana');
        if (!c.querySelector('iframe')) { c.innerHTML = `<iframe src="/grafana/?theme=light" style="width:100%; height:calc(100vh - 120px); border:none;"></iframe>`; }
    }
    if (pageId === 'cephflask') {
        document.getElementById('cephflaskIframe').src = getConfig('Ceph Flask');
    }
}
function refreshCurrentPage() { switchPage(currentPage); }

// ========== API 调用 ==========
async function fetchDashboardData() {
    try {
        const [summary, nodes, pods] = await Promise.all([
            fetch(`${API_BASE}/summary`).then(r=>r.json()), fetch(`${API_BASE}/nodes`).then(r=>r.json()), fetch(`${API_BASE}/pods`).then(r=>r.json())
        ]);
        if (!Array.isArray(nodes)) return;
        document.getElementById('statNodes').innerText = summary.nodeCount||0;
        document.getElementById('statPods').innerText = summary.podCount||0;
        document.getElementById('statRunning').innerText = summary.runningPods||0;
        document.getElementById('statDeploy').innerText = summary.deployCount||0;
        renderNodeTable('dashboardNodes', nodes);
        document.getElementById('nodeReadyCount').innerText = `${nodes.filter(n=>n.status==='Ready').length}/${nodes.length} Ready`;
        renderPodTable('dashboardPods', pods.slice(0,10));
        document.getElementById('podTotalCount').innerText = `共 ${pods.length} 个 Pods`;
    } catch(e) { console.error(e); }
}
async function fetchPodsList() { const d=await fetch(`${API_BASE}/pods`).then(r=>r.json()); renderPodTable('podsTable',d); document.getElementById('podListCount').innerText=`共 ${d.length} 个 Pods`; }
async function fetchNodesList() { const d=await fetch(`${API_BASE}/nodes`).then(r=>r.json()); renderNodeTable('nodesTable',d); document.getElementById('nodeListCount').innerText=`共 ${d.length} 个节点`; }
async function fetchNamespacesList() { const d=await fetch(`${API_BASE}/namespaces`).then(r=>r.json()); renderNamespacesTable(d); document.getElementById('nsListCount').innerText=`共 ${d.length} 个命名空间`; }
async function fetchDeploymentsList() { const d=await fetch(`${API_BASE}/deployments`).then(r=>r.json()); renderDeploymentsTable(d); document.getElementById('deployListCount').innerText=`共 ${d.length} 个 Deployments`; }
async function fetchServicesList() { const d=await fetch(`${API_BASE}/services`).then(r=>r.json()); renderServicesTable(d); document.getElementById('serviceListCount').innerText=`共 ${d.length} 个 Services`; }
async function fetchConfigMapsList() { const d=await fetch(`${API_BASE}/configmaps`).then(r=>r.json()); renderConfigMapsTable(d); document.getElementById('cmListCount').innerText=`共 ${d.length} 个 ConfigMaps`; }
async function fetchEventsList() { const d=await fetch(`${API_BASE}/events`).then(r=>r.json()); renderEventsTable(d); document.getElementById('eventListCount').innerText=`最近 ${d.length} 条事件`; }

// ========== 渲染函数 ==========
function renderNodeTable(id, nodes) { if(!nodes.length){document.getElementById(id).innerHTML='<div class="empty-state">暂无节点</div>';return;} let h=`<table><thead><tr><th>名称</th><th>状态</th><th>版本</th><th>系统</th><th>CPU</th></tr></thead><tbody>`; nodes.forEach(n=>{h+=`<tr><td><strong>${n.name}</strong></td><td><span class="status-badge ${n.status==='Ready'?'status-ready':'status-not-ready'}">${n.status}</span></td><td>${n.kubelet||'-'}</td><td>${n.os||'-'}</td><td>${n.cpu||'-'}</td></tr>`;}); document.getElementById(id).innerHTML=h+'</tbody></table>'; }
function renderPodTable(id, pods) { if(!pods.length){document.getElementById(id).innerHTML='<div class="empty-state">暂无 Pod</div>';return;} let h=`<table><thead><tr><th>名称</th><th>命名空间</th><th>状态</th><th>IP</th><th>节点</th><th>重启</th></tr></thead><tbody>`; pods.forEach(p=>{let cls=p.status==='Running'?'status-running':(p.status==='Pending'?'status-pending':'status-failed');h+=`<tr><td><strong>${p.name}</strong></td><td><span class="namespace-tag">${p.namespace}</span></td><td><span class="status-badge ${cls}">${p.status}</span></td><td>${p.ip||'-'}</td><td>${p.node||'-'}</td><td>${p.restarts||0}</td></tr>`;}); document.getElementById(id).innerHTML=h+'</tbody></table>'; }
function renderNamespacesTable(data) { if(!data.length){document.getElementById('namespacesTable').innerHTML='<div class="empty-state">暂无命名空间</div>';return;} let h=`<table><thead><tr><th>名称</th><th>状态</th><th>创建时间</th></tr></thead><tbody>`; data.forEach(n=>{h+=`<tr><td><strong>${n.name}</strong></td><td><span class="status-badge ${n.status==='Active'?'status-active':''}">${n.status}</span></td><td>${n.creationTime||'-'}</td></tr>`;}); document.getElementById('namespacesTable').innerHTML=h+'</tbody></table>'; }
function renderDeploymentsTable(data) { if(!data.length){document.getElementById('deploymentsTable').innerHTML='<div class="empty-state">暂无 Deployment</div>';return;} let h=`<table><thead><tr><th>名称</th><th>命名空间</th><th>副本</th><th>可用</th><th>就绪</th></tr></thead><tbody>`; data.forEach(d=>{h+=`<tr><td><strong>${d.name}</strong></td><td><span class="namespace-tag">${d.namespace}</span></td><td>${d.replicas||0}</td><td>${d.availableReplicas||0}</td><td>${d.readyReplicas||0}</td></tr>`;}); document.getElementById('deploymentsTable').innerHTML=h+'</tbody></table>'; }
function renderServicesTable(data) { if(!data.length){document.getElementById('servicesTable').innerHTML='<div class="empty-state">暂无 Service</div>';return;} let h=`<table><thead><tr><th>名称</th><th>命名空间</th><th>类型</th><th>Cluster IP</th><th>端口</th></tr></thead><tbody>`; data.forEach(s=>{h+=`<tr><td><strong>${s.name}</strong></td><td><span class="namespace-tag">${s.namespace}</span></td><td>${s.type||'-'}</td><td>${s.clusterIP||'-'}</td><td>${s.port||'-'}</td></tr>`;}); document.getElementById('servicesTable').innerHTML=h+'</tbody></table>'; }
function renderConfigMapsTable(data) { if(!data.length){document.getElementById('configmapsTable').innerHTML='<div class="empty-state">暂无 ConfigMap</div>';return;} let h=`<table><thead><tr><th>名称</th><th>命名空间</th><th>数据条目</th></tr></thead><tbody>`; data.forEach(c=>{h+=`<tr><td><strong>${c.name}</strong></td><td><span class="namespace-tag">${c.namespace}</span></td><td>${c.dataCount||0}</td></tr>`;}); document.getElementById('configmapsTable').innerHTML=h+'</tbody></table>'; }
function renderEventsTable(data) { if(!data.length){document.getElementById('eventsTable').innerHTML='<div class="empty-state">暂无事件</div>';return;} let h=`<table><thead><tr><th>类型</th><th>原因</th><th>命名空间</th><th>消息</th><th>时间</th></tr></thead><tbody>`; data.forEach(e=>{let cls=e.type==='Warning'?'status-warning':'status-ready';h+=`<tr><td><span class="status-badge ${cls}">${e.type||'-'}</span></td><td>${e.reason||'-'}</td><td>${e.namespace||'-'}</td><td>${e.message||'-'}</td><td>${e.timestamp||'-'}</td></tr>`;}); document.getElementById('eventsTable').innerHTML=h+'</tbody></table>'; }

// ========== 调度页面 ==========
async function loadSchedulerPage() { setTimeout(async()=>{await loadImageSelect();await loadNodeSelect();},200); }

async function loadImageSelect1() { const H='192.168.138.139:30002',s=document.getElementById('imageSelect'); if(!s)return; s.innerHTML='<option value="">⏳ 加载中...</option>'; try{ const r=await fetch('/api/harbor/images-with-tags'); const d=await r.json(); s.innerHTML='<option value="">-- 选择镜像 --</option>'; d.forEach(i=>{if(i.tags&&i.tags.length){i.tags.forEach(t=>{s.innerHTML+=`<option value="${H}/${i.name}:${t}">${i.name}:${t}</option>`;});}}); }catch(e){s.innerHTML='<option value="">-- 选择镜像 --</option>';} }


async function loadImageSelect2() {
    const H = '192.168.138.139:30002', s = document.getElementById('imageSelect');
    if (!s) return;
    s.innerHTML = '<option value="">⏳ 加载中...</option>';
    s.disabled = true;
    try {
        const r = await fetch('/api/harbor/images-with-tags');
        const d = await r.json();
        s.innerHTML = '<option value="">-- 选择镜像 --</option>';
        // 保存镜像列表到全局变量，供跳转时使用
        window.allImages = [];
        d.forEach(i => {
            if (i.tags && i.tags.length) {
                i.tags.forEach(t => {
                    const fullImage = `${H}/${i.name}:${t}`;
                    s.innerHTML += `<option value="${fullImage}">${i.name}:${t}</option>`;
                    window.allImages.push({ name: i.name, tag: t, full: fullImage });
                });
            }
        });
    } catch (e) {
        s.innerHTML = '<option value="">-- 选择镜像 --</option>';
    } finally {
        s.disabled = false;
    }
    // 如果是从 Harbor 页面跳转过来的，选中对应镜像
    if (window.pendingImage) {
        setTimeout(() => {
            for (let i = 0; i < s.options.length; i++) {
                if (s.options[i].value.includes(window.pendingImage)) {
                    s.selectedIndex = i;
                    window.pendingImage = null;
                    return;
                }
            }
        }, 500);
    }
}




window.allImages = [];
window.selectedImage = '';

async function loadImageSelect3() {
    const H = '192.168.138.139:30002';
    const input = document.getElementById('imageSearch');
    if (!input) return;
    input.value = '⏳ 加载中...';
    input.disabled = true;
    try {
        const r = await fetch('/api/harbor/cached-images');
        const d = await r.json();
        window.allImages = [];
        d.forEach(i => {
            if (i.tags && i.tags.length) {
                i.tags.forEach(t => {
                    window.allImages.push({ name: i.name, tag: t, full: `${H}/${i.name}:${t}` });
                });
            }
        });
        input.value = '';
        input.placeholder = `🔍 共 ${window.allImages.length} 个镜像，输入关键字搜索...`;
        // 如果是从 Harbor 跳转过来的
        if (window.pendingImage) {
            input.value = window.pendingImage;
            filterImages();
            window.pendingImage = null;
        }
    } catch (e) {
        input.placeholder = '加载失败';
    } finally {
        input.disabled = false;
    }
}

async function loadImageSelect() {
    const H = "192.168.138.139:30002";
    const input = document.getElementById("imageSearch");
    if (!input) return;
    input.value = "⏳ 加载镜像...";
    input.disabled = true;
    try {
	const r = await fetch("/api/harbor/cached-images");
        const d = await r.json();
        window.allImages = [];
        d.forEach(image => {
            window.allImages.push({
                name: image.name,
                tag: image.tag,
                full: `${H}/${image.name}:${image.tag}`
            });
        });
        input.value = "";
        input.placeholder = `🔍 共 ${window.allImages.length} 个镜像，输入关键字搜索...`;
        if (window.pendingImage) {
            input.value = window.pendingImage;
            filterImages();
            window.pendingImage = null;
        }
    } catch (e) {
        console.error("加载镜像失败:", e);
        input.placeholder = "加载失败";
    } finally {
        input.disabled = false;
    }
}

function filterImages() {
    const keyword = document.getElementById('imageSearch').value.toLowerCase();
    const dropdown = document.getElementById('imageDropdown');
    const filtered = window.allImages.filter(img => 
        img.name.toLowerCase().includes(keyword) || img.tag.toLowerCase().includes(keyword)
    );
    if (filtered.length === 0) {
        dropdown.innerHTML = '<div style="padding:10px;color:#999;">无匹配镜像</div>';
    } else {
        dropdown.innerHTML = filtered.slice(0, 50).map(img => 
            `<div onclick="selectImage('${img.full}', '${img.name}:${img.tag}')" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid #eee;hover:background:#f5f5f5;">${img.name}:${img.tag}</div>`
        ).join('');
    }
    dropdown.style.display = 'block';
}

function selectImage(full, label) {
    document.getElementById('imageSearch').value = label;
    document.getElementById('imageSelect').value = full;
    document.getElementById('imageDropdown').style.display = 'none';
    window.selectedImage = full;
}

function showImageList() {
    if (window.allImages.length > 0 && !document.getElementById('imageSearch').value) {
        const dropdown = document.getElementById('imageDropdown');
        dropdown.innerHTML = window.allImages.slice(0, 50).map(img => 
            `<div onclick="selectImage('${img.full}', '${img.name}:${img.tag}')" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid #eee;">${img.name}:${img.tag}</div>`
        ).join('');
        dropdown.style.display = 'block';
    }
}

// 点击其他地方隐藏下拉
document.addEventListener('click', (e) => {
    if (!e.target.closest('#imageSearch') && !e.target.closest('#imageDropdown')) {
        document.getElementById('imageDropdown').style.display = 'none';
    }
});

// 修改 createDeployment 中获取镜像的方式
// 原来: const image = document.getElementById('imageSelect').value;
// 改成: const image = document.getElementById('imageSelect').value || window.selectedImage;





async function loadNodeSelect() { const s=document.getElementById('nodeSelect'); if(!s)return; try{const nodes=await fetch('/api/nodes').then(r=>r.json());s.innerHTML='<option value="">-- 自动调度 --</option>';nodes.forEach(n=>{if(n.status==='Ready')s.innerHTML+=`<option value="${n.name}">${n.name}</option>`;});}catch(e){} }

async function createDeployment() {
    const image=document.getElementById('imageSelect').value  || window.selectedImage, cpu=document.getElementById('cpuCores').value, memory=document.getElementById('memoryMB').value;
    const node=document.getElementById('nodeSelect').value, replicas=document.getElementById('replicas')?.value||1, namespace=document.getElementById('namespaceSelect')?.value||'default';
    if(!image){alert('请选择镜像');return;}
    const deployName='scheduled-'+Date.now();
    const deployment={metadata:{name:deployName},spec:{replicas:parseInt(replicas),selector:{matchLabels:{app:deployName}},template:{metadata:{labels:{app:deployName}},spec:{containers:[{name:'app',image:image,imagePullPolicy:'IfNotPresent',resources:{requests:{cpu:cpu,memory:memory+'Mi'},limits:{cpu:cpu,memory:(parseInt(memory)*2)+'Mi'}}}]}}}};
    if(node) deployment.spec.template.spec.nodeName=node;
    try{const res=await fetch(`/api/namespaces/${namespace}/deployments`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(deployment)}); if(res.ok){alert('✅ 部署成功！\n名称: '+deployName);switchPage('deployments');}else{const err=await res.text();alert('❌ 部署失败: '+err);}}catch(e){alert('❌ 部署失败: '+e.message);}
}



// ========== Harbor ==========
window.harborPage = 1; window.harborPageSize = 10; window.harborAllImages = [];

async function loadHarborImages() {
    const p = document.getElementById('harborProjectSelect').value;
    window.harborAllImages = await fetchHarborImages(p);
    window.harborPage = 1;
    renderHarborImagesPage();
    document.getElementById('harborImageCount').innerText = `共 ${window.harborAllImages.length} 个镜像`;
}

function renderHarborImagesPage() {
    const start = (window.harborPage - 1) * window.harborPageSize;
    const pageImages = window.harborAllImages.slice(start, start + window.harborPageSize);
    renderHarborImagesTable(pageImages);
    renderHarborPagination();
}

function renderHarborImagesTable(images) {
    const c = document.getElementById('harborImagesTable');
    if (!images || !images.length) { c.innerHTML = '<div class="empty-state">暂无镜像</div>'; return; }
    let h = `<table><thead><tr><th>镜像名称</th><th>项目</th><th>拉取次数</th><th>操作</th></tr></thead><tbody>`;
    images.forEach(img => {
        h += `<tr><td><strong>${img.name.split('/').pop()}</strong></td><td>${img.project_id}</td><td>${img.pull_count || 0}</td><td><button onclick="deployImageFromHarbor('${img.name}')" style="padding:4px 12px;background:#4a90e2;color:white;border:none;border-radius:4px;">部署</button></td></tr>`;
    });
    c.innerHTML = h + '</tbody></table>';
}

function renderHarborPagination1() {
    const total = Math.ceil(window.harborAllImages.length / window.harborPageSize);
    const c = document.getElementById('harborImagesTable');
    const old = document.getElementById('harborPagination');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'harborPagination';
    div.style.cssText = 'display:flex;justify-content:center;gap:8px;margin-top:15px;';
    div.innerHTML = `
        <button onclick="window.harborPage=1;renderHarborImagesPage()" ${window.harborPage===1?'disabled':''} style="padding:6px 12px;border-radius:6px;border:1px solid #ddd;">首页</button>
        <button onclick="window.harborPage--;renderHarborImagesPage()" ${window.harborPage===1?'disabled':''} style="padding:6px 12px;border-radius:6px;border:1px solid #ddd;">上一页</button>
        <span style="padding:6px 12px;">第 ${window.harborPage}/${total} 页</span>
        <button onclick="window.harborPage++;renderHarborImagesPage()" ${window.harborPage===total?'disabled':''} style="padding:6px 12px;border-radius:6px;border:1px solid #ddd;">下一页</button>
        <button onclick="window.harborPage=total;renderHarborImagesPage()" ${window.harborPage===total?'disabled':''} style="padding:6px 12px;border-radius:6px;border:1px solid #ddd;">末页</button>`;
    c.parentNode.insertBefore(div, c.nextSibling);
}


function renderHarborPagination() {
    const total = Math.ceil(window.harborAllImages.length / window.harborPageSize);
    const c = document.getElementById('harborImagesTable');
    const old = document.getElementById('harborPagination');
    if (old) old.remove();
    const div = document.createElement('div');
    div.id = 'harborPagination';
    div.style.cssText = 'display:flex;justify-content:center;gap:8px;margin-top:15px;';
    div.innerHTML = `
        <button onclick="window.harborPage=1;renderHarborImagesPage()" ${window.harborPage===1 ? 'disabled' : ''}>首页</button>
        <button onclick="if(window.harborPage>1){window.harborPage--;renderHarborImagesPage()}" ${window.harborPage===1 ? 'disabled' : ''}>上一页</button>
        <span>第 ${window.harborPage}/${total} 页</span>
        <button onclick="if(window.harborPage<${total}){window.harborPage++;renderHarborImagesPage()}" ${window.harborPage===total ? 'disabled' : ''}>下一页</button>
        <button onclick="window.harborPage=${total};renderHarborImagesPage()" ${window.harborPage===total ? 'disabled' : ''}>末页</button>`;
    c.parentNode.insertBefore(div, c.nextSibling);
}


function deployImageFromHarbor1(imageName) {
    switchPage('scheduler');
    setTimeout(() => {
        const s = document.getElementById('imageSelect');
        if (s) {
            const check = setInterval(() => {
                for (let i = 0; i < s.options.length; i++) {
                    if (s.options[i].value.includes(imageName)) { s.selectedIndex = i; clearInterval(check); return; }
                }
            }, 200);
            setTimeout(() => clearInterval(check), 3000);
        }
    }, 500);
}

function deployImageFromHarbor(imageName) {
    window.pendingImage = imageName.replace("library/", "");
    switchPage('scheduler');
}

async function loadHarborProjectsPage() { try { const p = await fetchHarborProjects(); renderHarborProjectsTable(p); } catch (e) {} }
async function fetchHarborImages(project = 'library') { try { return await (await fetch(`/api/harbor/projects/${project}/repositories`)).json(); } catch (e) { return []; } }
async function fetchHarborProjects() { try { return await (await fetch('/api/harbor/projects')).json(); } catch (e) { return []; } }
function renderHarborProjectsTable(projects) { const c = document.getElementById('harborProjectsTable'); if (!projects || !projects.length) { c.innerHTML = '<div class="empty-state">暂无项目</div>'; return; } let h = `<table><thead><tr><th>项目名称</th><th>访问级别</th><th>镜像数量</th></tr></thead><tbody>`; projects.forEach(p => { h += `<tr><td><strong>${p.name}</strong></td><td>${p.metadata?.public === 'true' ? '公开' : '私有'}</td><td>${p.repo_count || 0}</td></tr>`; }); c.innerHTML = h + '</tbody></table>'; }
function refreshHarborImages() { loadHarborImages(); }



